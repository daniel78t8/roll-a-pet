        <Item class="ModuleScript" referent="3">
          <Properties>
            <string name="Name">Config</string>
            <string name="Source"><![CDATA[-- Zombie-Modus: alle Einstellungen an einer Stelle.
-- Werte hier aendern, um Geld, Wellen, Pets und Effekte anzupassen.

local Config = {}

--------------------------------------------------------------------------
-- Map (Aufbau wie in der Skizze: Zombies links -> Mitte mit Pet-Plaetzen
-- oben und unten am Rand -> Huette rechts)
--------------------------------------------------------------------------
Config.Map = {
	-- Weit weg von der Lobby, damit nichts ueberlappt
	Origin = Vector3.new(0, 0, 600),

	LaneLength = 100, -- Zombie-Weg links
	LaneWidth = 28,
	CenterWidth = 40, -- Mittelteil mit den Pet-Plaetzen
	CenterDepth = 80,
	PathHalfWidth = 14, -- ab hier beginnt der "Rand" mit den Plaetzen
	HutAreaLength = 44,
	HutAreaWidth = 26,

	SlotsPerSide = 3, -- 3 Plaetze oben + 3 unten (wie gezeichnet)
	SlotDistanceFromPath = 11, -- wie weit die Plaetze von der Wegmitte weg sind (zusaetzlich zu PathHalfWidth)

	-- Portal in der Lobby, das in den Zombie-Modus teleportiert
	CreateLobbyPortal = true,
	LobbyPortalPosition = Vector3.new(0, 0, 40),
}

--------------------------------------------------------------------------
-- Geld: am Anfang bewusst wenig, spaeter langsam mehr
--------------------------------------------------------------------------
Config.Economy = {
	CurrencyName = "Coins", -- Name des Werts in leaderstats
	CreateLeaderstatsIfMissing = true,
	StartingCoins = 0, -- nur falls der Wert neu angelegt wird

	-- Grundbelohnung pro Zombie-Typ (vor dem Multiplikator)
	KillReward = {
		Zombie = 1,
		Runner = 1,
		Brute = 3,
		Boss = 15,
	},

	-- Welle 1 gibt nur 20 % der Belohnung, das steigt bis Welle 10 auf 100 %.
	-- Bruchteile werden gesammelt (0,2 Coins pro Kill -> jeder 5. Kill gibt 1 Coin).
	EarlyGameMultiplier = 0.2,
	EarlyGameRampWaves = 10,
	GrowthPerWaveAfterRamp = 0.08, -- danach +8 % pro Welle
	MaxMultiplier = 4,

	WaveBonusBase = 1, -- Bonus fuer jede ueberstandene Welle
	WaveBonusPerWave = 1,
}

--------------------------------------------------------------------------
-- Wellen und Zombies
--------------------------------------------------------------------------
Config.Waves = {
	FirstIntermission = 20, -- Zeit zum Platzieren vor Welle 1
	Intermission = 10,
	GameOverPause = 8,

	BaseCount = 4,
	CountPerWave = 2,
	MaxCount = 45,

	SpawnInterval = 1.4,
	MinSpawnInterval = 0.45,
	SpawnIntervalDecay = 0.06, -- pro Welle schneller

	HealthGrowthPerWave = 0.18,
	BossEvery = 5, -- jede 5. Welle kommt ein Boss
}

Config.ZombieTypes = {
	Zombie = {
		Health = 20,
		Speed = 5,
		HutDamage = 8,
		Scale = 1,
		FromWave = 1,
		Weight = 10,
		Skin = Color3.fromRGB(110, 160, 90),
		Shirt = Color3.fromRGB(70, 90, 140),
		Pants = Color3.fromRGB(60, 50, 40),
		Eyes = Color3.fromRGB(255, 60, 40),
	},
	Runner = {
		Health = 12,
		Speed = 9.5,
		HutDamage = 5,
		Scale = 0.85,
		FromWave = 3,
		Weight = 4,
		Skin = Color3.fromRGB(150, 175, 95),
		Shirt = Color3.fromRGB(170, 70, 50),
		Pants = Color3.fromRGB(45, 45, 60),
		Eyes = Color3.fromRGB(255, 170, 0),
	},
	Brute = {
		Health = 90,
		Speed = 3.2,
		HutDamage = 20,
		Scale = 1.45,
		FromWave = 6,
		Weight = 2,
		Skin = Color3.fromRGB(80, 120, 75),
		Shirt = Color3.fromRGB(60, 60, 60),
		Pants = Color3.fromRGB(80, 60, 35),
		Eyes = Color3.fromRGB(255, 30, 30),
	},
	Boss = {
		Health = 450,
		Speed = 2.4,
		HutDamage = 80,
		Scale = 2.3,
		IsBoss = true,
		Skin = Color3.fromRGB(95, 70, 120),
		Shirt = Color3.fromRGB(40, 20, 30),
		Pants = Color3.fromRGB(30, 20, 25),
		Eyes = Color3.fromRGB(180, 255, 60),
	},
}

Config.Hut = {
	MaxHealth = 250,
	RegenPerWave = 30,
}

--------------------------------------------------------------------------
-- Pets
--------------------------------------------------------------------------
Config.PetPlacement = {
	MaxPetsPerPlayer = 3,
	PlacementCost = 0, -- Coins pro Platzierung (0 = gratis)
}

Config.Rarities = {
	-- Damage pro Treffer, Range in Studs, Cooldown in Sekunden
	Common = { Order = 1, Damage = 4, Range = 30, Cooldown = 1.0, Color = Color3.fromRGB(210, 210, 210) },
	Uncommon = { Order = 2, Damage = 6, Range = 31, Cooldown = 0.95, Color = Color3.fromRGB(90, 220, 110) },
	Rare = { Order = 3, Damage = 9, Range = 33, Cooldown = 0.9, Color = Color3.fromRGB(70, 160, 255) },
	Epic = { Order = 4, Damage = 14, Range = 36, Cooldown = 0.8, Color = Color3.fromRGB(180, 90, 255) },
	Legendary = { Order = 5, Damage = 22, Range = 40, Cooldown = 0.7, Color = Color3.fromRGB(255, 190, 40) },
	Mythic = { Order = 6, Damage = 35, Range = 45, Cooldown = 0.6, Color = Color3.fromRGB(255, 80, 160) },
}

-- Elemente bestimmen Effekt UND Zusatzwirkung
Config.Elements = {
	Normal = { Color = Color3.fromRGB(255, 240, 170) }, -- normaler Treffer
	Fire = { Color = Color3.fromRGB(255, 120, 30), BurnDuration = 3, BurnFraction = 0.2 }, -- brennt nach
	Ice = { Color = Color3.fromRGB(130, 220, 255), SlowDuration = 2, SlowFactor = 0.55 }, -- verlangsamt
	Lightning = { Color = Color3.fromRGB(255, 250, 130), ChainCount = 2, ChainRange = 12, ChainFraction = 0.6 }, -- springt weiter
	Magic = { Color = Color3.fromRGB(200, 110, 255), SplashRadius = 7, SplashFraction = 0.5 }, -- Flaechenschaden
}

Config.CritChance = 0.1
Config.CritMultiplier = 2

-- Bekannte Pets. Unbekannte Pets bekommen DefaultPet.
-- Tipp: Ein Pet-Model kann auch die Attribute "Rarity" und "Element" haben,
-- die gehen dann vor.
Config.DefaultPet = { Rarity = "Common", Element = "Normal" }
Config.Pets = {
	Dog = { Rarity = "Common", Element = "Normal" },
	Cat = { Rarity = "Common", Element = "Normal" },
	Bunny = { Rarity = "Uncommon", Element = "Magic" },
	Bear = { Rarity = "Uncommon", Element = "Normal" },
	Fox = { Rarity = "Rare", Element = "Fire" },
	Penguin = { Rarity = "Rare", Element = "Ice" },
	Owl = { Rarity = "Epic", Element = "Lightning" },
	Unicorn = { Rarity = "Epic", Element = "Magic" },
	Dragon = { Rarity = "Legendary", Element = "Fire" },
	Yeti = { Rarity = "Legendary", Element = "Ice" },
	Phoenix = { Rarity = "Mythic", Element = "Fire" },
	["Storm Wolf"] = { Rarity = "Mythic", Element = "Lightning" },
}

-- Wo die eigenen Pets des Spielers liegen (siehe PetInventory.luau)
Config.Inventory = {
	PlayerFolderName = "Pets", -- player.Pets (Kinder = Pets)
	StarterPets = { "Dog", "Cat" }, -- falls der Spieler (noch) keine Pets hat
	ModelFolderNames = { "PetModels", "Pets" }, -- in ReplicatedStorage / ServerStorage
	PetSize = 4, -- Pet-Models werden auf diese Groesse skaliert
}

--------------------------------------------------------------------------
-- Effekte (Texturen sind in Roblox eingebaut, koennen durch eigene
-- rbxassetid:// IDs ersetzt werden)
--------------------------------------------------------------------------
Config.VFX = {
	Textures = {
		Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
		Smoke = "rbxasset://textures/particles/smoke_main.dds",
		Fire = "rbxasset://textures/particles/fire_main.dds",
	},
	ProjectileSpeed = 70,
	ShowDamageNumbers = true,
	MaxActiveProjectiles = 60,
}

return Config
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Layout</string>
            <string name="Source"><![CDATA[-- Berechnet alle Positionen der Zombie-Map aus Config.Map.
-- X-Achse: links (Zombies) -> rechts (Huette). Z-Achse: oben (-) / unten (+).

local Config = require(script.Parent.Config)

local M = Config.Map
local Layout = {}

Layout.Origin = M.Origin

Layout.CenterMinX = -M.CenterWidth / 2
Layout.CenterMaxX = M.CenterWidth / 2
Layout.LaneMinX = Layout.CenterMinX - M.LaneLength
Layout.HutAreaMinX = Layout.CenterMaxX
Layout.HutAreaMaxX = Layout.CenterMaxX + M.HutAreaLength

Layout.HutSize = Vector3.new(16, 10, 16)
Layout.HutCenterX = Layout.HutAreaMinX + 22
Layout.HutFrontX = Layout.HutCenterX - Layout.HutSize.X / 2

function Layout.World(x: number, y: number, z: number): Vector3
	return M.Origin + Vector3.new(x, y, z)
end

-- Weg der Zombies (Bodenhoehe)
Layout.ZombieStart = Layout.World(Layout.LaneMinX + 4, 0, 0)
Layout.ZombieEnd = Layout.World(Layout.HutFrontX - 1.5, 0, 0)
Layout.ZombieSpreadZ = 6 -- Zombies laufen leicht versetzt

Layout.PlayerSpawn = Layout.World(Layout.HutAreaMaxX - 6, 4, -7)
Layout.ReturnPortal = Layout.World(Layout.HutAreaMaxX - 6, 0, 7)

-- Pet-Plaetze: nur oben und unten am Rand des Mittelteils
Layout.Slots = {}
do
	local n = M.SlotsPerSide
	local slotZ = M.PathHalfWidth + M.SlotDistanceFromPath
	for _, side in { "Top", "Bottom" } do
		local sign = if side == "Top" then -1 else 1
		for i = 1, n do
			local x = Layout.CenterMinX + M.CenterWidth * (i - 0.5) / n
			table.insert(Layout.Slots, {
				Id = side .. i,
				Side = side,
				Position = Layout.World(x, 0, sign * slotZ),
				-- Blickrichtung zum Weg
				FacePosition = Layout.World(x, 0, 0),
			})
		end
	end
end

-- Bereich, in dem ein Spieler als "im Zombie-Modus" gilt
Layout.BoundsMin = Layout.World(Layout.LaneMinX - 10, -20, -M.CenterDepth / 2 - 10)
Layout.BoundsMax = Layout.World(Layout.HutAreaMaxX + 10, 80, M.CenterDepth / 2 + 10)

function Layout.IsInside(position: Vector3): boolean
	local a, b = Layout.BoundsMin, Layout.BoundsMax
	return position.X >= a.X
		and position.X <= b.X
		and position.Y >= a.Y
		and position.Y <= b.Y
		and position.Z >= a.Z
		and position.Z <= b.Z
end

return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">PetData</string>
            <string name="Source"><![CDATA[-- Liefert Seltenheit, Element und Kampfwerte fuer ein Pet.

local Config = require(script.Parent.Config)

export type PetInfo = {
	Name: string,
	Rarity: string,
	Element: string,
	Damage: number,
	Range: number,
	Cooldown: number,
}

local PetData = {}

function PetData.Get(petName: string, template: Instance?): PetInfo
	local entry = Config.Pets[petName] or Config.DefaultPet
	local rarity = entry.Rarity
	local element = entry.Element

	-- Attribute am Pet-Model haben Vorrang
	if template then
		local r = template:GetAttribute("Rarity")
		local e = template:GetAttribute("Element")
		if typeof(r) == "string" and Config.Rarities[r] then
			rarity = r
		end
		if typeof(e) == "string" and Config.Elements[e] then
			element = e
		end
	end

	if not Config.Rarities[rarity] then
		rarity = "Common"
	end
	if not Config.Elements[element] then
		element = "Normal"
	end

	local stats = Config.Rarities[rarity]
	return {
		Name = petName,
		Rarity = rarity,
		Element = element,
		Damage = stats.Damage,
		Range = stats.Range,
		Cooldown = stats.Cooldown,
	}
end

function PetData.RarityOrder(rarity: string): number
	local r = Config.Rarities[rarity]
	return if r then r.Order else 0
end

return PetData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">PetVFX</string>
            <string name="Source"><![CDATA[-- Effekte fuer Pets und Zombies (laeuft nur auf dem Client).
-- Ideen aus Tower-Defense-Spielen: Muendungsblitz beim Schiessen, Geschoss mit
-- Schweif, kurzer Partikel-Burst beim Treffer (Emit statt Dauer-Emitter),
-- aufblitzende Neon-Kugel + Speed-Lines (Anime-Stil), Schadenszahlen,
-- Aura je nach Seltenheit.

local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(script.Parent.Config)

local TEX = Config.VFX.Textures
local PetVFX = {}

local fxFolder = Instance.new("Folder")
fxFolder.Name = "ZombieDefenseFX"
fxFolder.Parent = workspace

--------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------

local function elementColor(element: string): Color3
	local e = Config.Elements[element]
	return if e then e.Color else Color3.new(1, 1, 1)
end

local function rarityColor(rarity: string): Color3
	local r = Config.Rarities[rarity]
	return if r then r.Color else Color3.new(1, 1, 1)
end

local function rarityOrder(rarity: string): number
	local r = Config.Rarities[rarity]
	return if r then r.Order else 1
end

local function tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function fxPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = props.Parent or fxFolder
	return p
end

local function seq(a: number, b: number): NumberSequence
	return NumberSequence.new(a, b)
end

local function colorSeq(a: Color3, b: Color3?): ColorSequence
	return ColorSequence.new(a, b or a)
end

-- Einmaliger Partikel-Burst an einer Position
local function burst(position: Vector3, opts: { [string]: any })
	local holder = fxPart({ Size = Vector3.new(0.2, 0.2, 0.2), Position = position, Transparency = 1 })
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Texture = opts.Texture or TEX.Sparkle
	e.Color = opts.Color or colorSeq(Color3.new(1, 1, 1))
	e.Size = opts.Size or seq(1, 0)
	e.Transparency = opts.Transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.3), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = opts.Lifetime or NumberRange.new(0.2, 0.6)
	e.Speed = opts.Speed or NumberRange.new(20, 40)
	e.SpreadAngle = opts.Spread or Vector2.new(180, 180)
	e.Drag = opts.Drag or 8
	e.LightEmission = opts.LightEmission or 1
	e.Acceleration = opts.Acceleration or Vector3.zero
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = opts.RotSpeed or NumberRange.new(-180, 180)
	e.EmissionDirection = opts.Direction or Enum.NormalId.Top
	e.Parent = holder
	e:Emit(opts.Count or 16)
	-- Erst nach der Lebenszeit loeschen, sonst verschwinden die Partikel sofort
	Debris:AddItem(holder, e.Lifetime.Max + 0.3)
end

-- Aufblitzende Neon-Kugel
local function flash(position: Vector3, color: Color3, fromSize: number, toSize: number, duration: number)
	local ball = fxPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * fromSize,
		Position = position,
		Color = color,
		Transparency = 0.1,
	})
	tween(ball, duration, { Size = Vector3.one * toSize, Transparency = 1 })
	Debris:AddItem(ball, duration + 0.05)
end

local function flashLight(position: Vector3, color: Color3, range: number, brightness: number, duration: number)
	local holder = fxPart({ Size = Vector3.new(0.2, 0.2, 0.2), Position = position, Transparency = 1 })
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = holder
	tween(l, duration, { Brightness = 0 })
	Debris:AddItem(holder, duration + 0.05)
end

-- Echter Ring aus Segmenten, der sich ausbreitet (Schockwelle)
local function ring(position: Vector3, color: Color3, fromRadius: number, toRadius: number, duration: number, segments: number?)
	local n = segments or 16
	for i = 1, n do
		local angle = (i / n) * math.pi * 2
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local function cf(radius: number)
			local p = position + dir * radius
			return CFrame.lookAt(p, p + dir) * CFrame.Angles(0, math.pi / 2, 0)
		end
		local len0 = 2 * math.pi * fromRadius / n * 1.1
		local len1 = 2 * math.pi * toRadius / n * 1.1
		local seg = fxPart({ Size = Vector3.new(0.35, 0.35, len0), CFrame = cf(fromRadius), Color = color, Transparency = 0.05 })
		tween(seg, duration, { CFrame = cf(toRadius), Size = Vector3.new(0.12, 0.12, len1), Transparency = 1 })
		Debris:AddItem(seg, duration + 0.05)
	end
end

-- Anime-Speed-Lines vom Treffpunkt nach aussen
local function speedLines(position: Vector3, color: Color3, count: number, length: number, duration: number)
	for _ = 1, count do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8 - 0.2, math.random() - 0.5).Unit
		local start = position + dir * 0.5
		local line = fxPart({ Size = Vector3.new(0.15, 0.15, length), CFrame = CFrame.lookAt(start + dir * length / 2, start + dir * length), Color = color, Transparency = 0 })
		local finish = position + dir * (length * 1.8)
		tween(line, duration, { CFrame = CFrame.lookAt(finish, finish + dir), Size = Vector3.new(0.05, 0.05, length * 0.3), Transparency = 1 })
		Debris:AddItem(line, duration + 0.05)
	end
end

-- Kleine Splitter (Eis, Holz), die wegfliegen
local function shards(position: Vector3, color: Color3, count: number, material: Enum.Material?)
	for _ = 1, count do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.9 + 0.2, math.random() - 0.5).Unit
		local s = fxPart({
			Size = Vector3.new(0.3, 0.3, 0.9) * (0.6 + math.random() * 0.6),
			CFrame = CFrame.lookAt(position, position + dir),
			Color = color,
			Material = material or Enum.Material.Neon,
			Transparency = 0.1,
		})
		local target = position + dir * (3 + math.random() * 3)
		tween(s, 0.45, { CFrame = CFrame.lookAt(target, target + dir) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), Transparency = 1 })
		Debris:AddItem(s, 0.5)
	end
end

-- Zickzack-Blitz zwischen zwei Punkten
local function bolt(a: Vector3, b: Vector3, color: Color3, width: number)
	local dist = (b - a).Magnitude
	local n = math.max(3, math.floor(dist / 3))
	local points = { a }
	local dir = (b - a).Unit
	local side = dir:Cross(Vector3.yAxis)
	if side.Magnitude < 0.01 then
		side = Vector3.xAxis
	end
	side = side.Unit
	local up = side:Cross(dir).Unit
	for i = 1, n - 1 do
		local jitter = (side * (math.random() - 0.5) + up * (math.random() - 0.5)) * 2.2
		table.insert(points, a:Lerp(b, i / n) + jitter)
	end
	table.insert(points, b)
	for i = 1, #points - 1 do
		local p0, p1 = points[i], points[i + 1]
		local len = (p1 - p0).Magnitude
		local mid = (p0 + p1) / 2
		local core = fxPart({ Size = Vector3.new(width, width, len), CFrame = CFrame.lookAt(mid, p1), Color = Color3.new(1, 1, 1) })
		local glow = fxPart({ Size = Vector3.new(width * 3, width * 3, len), CFrame = CFrame.lookAt(mid, p1), Color = color, Transparency = 0.55 })
		tween(core, 0.18, { Transparency = 1 })
		tween(glow, 0.22, { Transparency = 1, Size = Vector3.new(width * 5, width * 5, len) })
		Debris:AddItem(core, 0.2)
		Debris:AddItem(glow, 0.25)
	end
end

local function billboardAt(position: Vector3, size: UDim2): (BillboardGui, BasePart)
	local holder = fxPart({ Size = Vector3.new(0.2, 0.2, 0.2), Position = position, Transparency = 1 })
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 160
	gui.Adornee = holder
	gui.Parent = holder
	return gui, holder
end

--------------------------------------------------------------------------
-- Treffer
--------------------------------------------------------------------------

function PetVFX.Impact(position: Vector3, element: string, rarity: string, isCrit: boolean)
	local color = elementColor(element)
	local order = rarityOrder(rarity)
	local scale = 1 + order * 0.12 + (if isCrit then 0.5 else 0)

	flash(position, color, 0.8, 3.5 * scale, 0.18)
	flash(position, Color3.new(1, 1, 1), 0.4, 1.8 * scale, 0.1)
	burst(position, {
		Color = colorSeq(Color3.new(1, 1, 1), color),
		Count = 10 + order * 3,
		Size = seq(0.6 * scale, 0),
		Speed = NumberRange.new(18, 34),
	})
	flashLight(position, color, 10 * scale, 3, 0.25)

	if element == "Fire" then
		burst(position, {
			Texture = TEX.Fire,
			Color = colorSeq(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 70, 20)),
			Count = 10 + order * 2,
			Size = seq(2 * scale, 0),
			Speed = NumberRange.new(6, 14),
			Lifetime = NumberRange.new(0.3, 0.6),
			Acceleration = Vector3.new(0, 12, 0),
		})
		burst(position, {
			Texture = TEX.Smoke,
			Color = colorSeq(Color3.fromRGB(80, 70, 60)),
			Count = 4,
			Size = seq(1.5, 3.5),
			Speed = NumberRange.new(2, 5),
			Lifetime = NumberRange.new(0.6, 1),
			LightEmission = 0,
			Transparency = seq(0.4, 1),
		})
	elseif element == "Ice" then
		ring(position - Vector3.new(0, 1.5, 0), color, 0.5, 4 * scale, 0.35, 14)
		shards(position, color, 5 + order)
		burst(position, { Color = colorSeq(Color3.new(1, 1, 1), color), Count = 8, Speed = NumberRange.new(3, 8), Lifetime = NumberRange.new(0.6, 1), Acceleration = Vector3.new(0, -10, 0) })
	elseif element == "Lightning" then
		speedLines(position, color, 6 + order, 2.5, 0.2)
		flash(position, Color3.new(1, 1, 0.8), 1, 5 * scale, 0.08)
	elseif element == "Magic" then
		local radius = Config.Elements.Magic.SplashRadius
		ring(position - Vector3.new(0, 1.5, 0), color, 0.5, radius, 0.4, 20)
		burst(position, {
			Color = colorSeq(Color3.fromRGB(255, 150, 240), color),
			Count = 18 + order * 2,
			Size = seq(0.9, 0),
			Speed = NumberRange.new(8, 20),
			Lifetime = NumberRange.new(0.4, 0.8),
			Acceleration = Vector3.new(0, 6, 0),
		})
	end

	if isCrit then
		speedLines(position, Color3.new(1, 1, 1), 8, 3, 0.22)
		ring(position, Color3.fromRGB(255, 230, 120), 0.5, 3.5, 0.25, 12)
	end
end

--------------------------------------------------------------------------
-- Angriff (Muendungsblitz + Geschoss + Treffer)
--------------------------------------------------------------------------

type Projectile = {
	Part: BasePart,
	From: Vector3,
	GetTarget: () -> Vector3,
	Start: number,
	Duration: number,
	Element: string,
	Rarity: string,
	Crit: boolean,
	Seed: number,
}

local projectiles: { Projectile } = {}

local function makeProjectile(element: string, rarity: string, from: Vector3): BasePart
	local color = elementColor(element)
	local order = rarityOrder(rarity)
	local size = 0.8 + order * 0.15
	local p: BasePart
	if element == "Ice" then
		p = fxPart({ Size = Vector3.new(size * 0.6, size * 0.6, size * 2), Position = from, Color = color, Material = Enum.Material.Glass, Transparency = 0.15 })
	else
		p = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * size, Position = from, Color = color })
	end

	-- Schweif
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, size * 0.45, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -size * 0.45, 0)
	a1.Parent = p
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = colorSeq(Color3.new(1, 1, 1), color)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = seq(1, 0)
	trail.Lifetime = 0.18 + order * 0.03
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Parent = p

	-- Partikel hinter dem Geschoss
	local e = Instance.new("ParticleEmitter")
	e.Texture = if element == "Fire" then TEX.Fire else TEX.Sparkle
	e.Color = if element == "Fire" then colorSeq(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 60, 10)) else colorSeq(Color3.new(1, 1, 1), color)
	e.Size = seq(if element == "Fire" then size * 1.6 else size * 0.7, 0)
	e.Transparency = seq(0, 1)
	e.Lifetime = NumberRange.new(0.2, 0.4)
	e.Rate = 30 + order * 8
	e.Speed = NumberRange.new(0.5, 2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 1
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-200, 200)
	e.Parent = p

	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = 6 + order
	l.Brightness = 2
	l.Parent = p
	return p
end

-- data: Tabelle vom Server (siehe PetService.attack)
-- getTargetPosition: liefert die aktuelle Position des Ziels (fuer Zielsuche)
function PetVFX.Attack(data: { [string]: any }, getTargetPosition: (() -> Vector3?)?)
	local element: string = data.Element
	local rarity: string = data.Rarity
	local from: Vector3 = data.From
	local to: Vector3 = data.To
	local color = elementColor(element)
	local order = rarityOrder(rarity)

	-- Muendungsblitz am Pet
	flash(from, color, 0.6, 2 + order * 0.3, 0.14)
	burst(from, { Color = colorSeq(Color3.new(1, 1, 1), color), Count = 4 + order, Size = seq(0.4, 0), Speed = NumberRange.new(6, 12), Lifetime = NumberRange.new(0.15, 0.3) })

	if element == "Lightning" then
		bolt(from, to, color, 0.18 + order * 0.03)
		task.delay(0.05, function()
			bolt(from, to, color, 0.12)
		end)
		local prev = to
		for _, pos in data.Chain or {} do
			bolt(prev, pos, color, 0.14)
			PetVFX.Impact(pos, element, rarity, false)
			prev = pos
		end
		PetVFX.Impact(to, element, rarity, data.Crit)
		return
	end

	if #projectiles >= Config.VFX.MaxActiveProjectiles then
		task.delay(data.Travel, PetVFX.Impact, to, element, rarity, data.Crit)
		return
	end

	local lastKnown = to
	table.insert(projectiles, {
		Part = makeProjectile(element, rarity, from),
		From = from,
		GetTarget = function()
			local p = getTargetPosition and getTargetPosition()
			if p then
				lastKnown = p
			end
			return lastKnown
		end,
		Start = os.clock(),
		Duration = math.max(data.Travel, 0.05),
		Element = element,
		Rarity = rarity,
		Crit = data.Crit,
		Seed = math.random() * 10,
	})
end

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		local alpha = math.clamp((now - pr.Start) / pr.Duration, 0, 1)
		local target = pr.GetTarget()
		local pos = pr.From:Lerp(target, alpha)
		local dir = (target - pr.From)
		-- Bogen nach oben; Magie fliegt in einer Spirale
		pos += Vector3.new(0, math.sin(alpha * math.pi) * math.min(dir.Magnitude * 0.12, 4), 0)
		if pr.Element == "Magic" and dir.Magnitude > 0.1 then
			local side = dir.Unit:Cross(Vector3.yAxis)
			if side.Magnitude > 0.01 then
				pos += side.Unit * math.sin(alpha * math.pi * 3 + pr.Seed) * 1.2 * (1 - alpha)
			end
		end
		local look = if (pos - pr.Part.Position).Magnitude > 0.01 then pos + (pos - pr.Part.Position) else pos + Vector3.xAxis
		pr.Part.CFrame = CFrame.lookAt(pos, look)

		if alpha >= 1 then
			table.remove(projectiles, i)
			PetVFX.Impact(target, pr.Element, pr.Rarity, pr.Crit)
			-- Schweif ausklingen lassen
			pr.Part.Transparency = 1
			for _, d in pr.Part:GetChildren() do
				if d:IsA("ParticleEmitter") then
					d.Enabled = false
				elseif d:IsA("PointLight") then
					d.Enabled = false
				end
			end
			Debris:AddItem(pr.Part, 0.5)
		end
	end
end)

--------------------------------------------------------------------------
-- Schadenszahlen und Coins
--------------------------------------------------------------------------

local function popText(position: Vector3, text: string, color: Color3, scale: number, rise: number, duration: number)
	local gui, holder = billboardAt(position + Vector3.new((math.random() - 0.5) * 1.5, 1, (math.random() - 0.5) * 1.5), UDim2.fromScale(4 * scale, 1.6 * scale))
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(20, 20, 20)
	label.Parent = gui
	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 0.3
	uiScale.Parent = label
	tween(uiScale, 0.15, { Scale = 1.15 }, Enum.EasingStyle.Back)
	task.delay(0.15, function()
		tween(uiScale, 0.1, { Scale = 1 })
	end)
	tween(gui, duration, { StudsOffset = Vector3.new(0, rise, 0) }, Enum.EasingStyle.Quad)
	task.delay(duration * 0.55, function()
		tween(label, duration * 0.45, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(holder, duration + 0.05)
end

function PetVFX.DamageNumber(position: Vector3, amount: number, element: string, isCrit: boolean)
	if not Config.VFX.ShowDamageNumbers then
		return
	end
	if isCrit then
		popText(position, "KRIT! " .. amount, Color3.fromRGB(255, 90, 60), 1.5, 4, 0.9)
	else
		popText(position, tostring(amount), elementColor(element):Lerp(Color3.new(1, 1, 1), 0.3), 1, 3, 0.7)
	end
end

function PetVFX.CoinPop(position: Vector3, amount: number)
	popText(position + Vector3.new(0, 1.5, 0), ("+%d 💰"):format(amount), Color3.fromRGB(255, 215, 60), 1.3, 5, 1.1)
	local coin = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.25, 1.4, 1.4),
		Position = position,
		Color = Color3.fromRGB(255, 200, 40),
		Material = Enum.Material.Neon,
	})
	tween(coin, 0.8, { CFrame = CFrame.new(position + Vector3.new(0, 6, 0)) * CFrame.Angles(0, math.pi * 4, 0), Transparency = 1 })
	Debris:AddItem(coin, 0.85)
	burst(position, { Color = colorSeq(Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 190, 30)), Count = 10, Size = seq(0.5, 0), Speed = NumberRange.new(6, 14) })
end

--------------------------------------------------------------------------
-- Pets: Aura, Erscheinen
--------------------------------------------------------------------------

export type AuraHandle = {
	Update: (t: number) -> (),
	Destroy: () -> (),
}

function PetVFX.Aura(model: Model, padPosition: Vector3): AuraHandle
	local rarity = model:GetAttribute("Rarity") or "Common"
	local element = model:GetAttribute("Element") or "Normal"
	local order = rarityOrder(rarity)
	local rColor = rarityColor(rarity)
	local eColor = elementColor(element)
	local cleanup: { Instance } = {}

	local cf, size = model:GetBoundingBox()
	-- Unsichtbarer Anker im Model, damit Effekte mitschweben
	local anchor = fxPart({ Name = "AuraAnchor", Size = size * 0.8, CFrame = cf, Transparency = 1, Parent = model })
	table.insert(cleanup, anchor)

	local main = Instance.new("ParticleEmitter")
	main.Texture = TEX.Sparkle
	main.Color = colorSeq(Color3.new(1, 1, 1), rColor)
	main.Size = seq(0.3 + order * 0.08, 0)
	main.Transparency = seq(0.1, 1)
	main.Lifetime = NumberRange.new(0.8, 1.4)
	main.Rate = 2 + order * 3
	main.Speed = NumberRange.new(0.5, 1.5)
	main.SpreadAngle = Vector2.new(180, 180)
	main.Acceleration = Vector3.new(0, 1 + order * 0.6, 0)
	main.LightEmission = 1
	main.Shape = Enum.ParticleEmitterShape.Box
	main.Parent = anchor

	-- Element-Partikel
	if element ~= "Normal" then
		local e = Instance.new("ParticleEmitter")
		e.LightEmission = 1
		e.Rotation = NumberRange.new(0, 360)
		e.Shape = Enum.ParticleEmitterShape.Box
		e.Parent = anchor
		if element == "Fire" then
			e.Texture = TEX.Fire
			e.Color = colorSeq(Color3.fromRGB(255, 200, 90), Color3.fromRGB(255, 60, 10))
			e.Size = seq(0.7, 0)
			e.Lifetime = NumberRange.new(0.4, 0.8)
			e.Rate = 8
			e.Speed = NumberRange.new(1, 3)
			e.Acceleration = Vector3.new(0, 6, 0)
		elseif element == "Ice" then
			e.Texture = TEX.Sparkle
			e.Color = colorSeq(Color3.new(1, 1, 1), eColor)
			e.Size = seq(0.35, 0.1)
			e.Lifetime = NumberRange.new(1, 1.6)
			e.Rate = 6
			e.Speed = NumberRange.new(0.2, 0.6)
			e.Acceleration = Vector3.new(0, -2, 0)
			e.RotSpeed = NumberRange.new(-60, 60)
		elseif element == "Lightning" then
			e.Texture = TEX.Sparkle
			e.Color = colorSeq(Color3.new(1, 1, 1), eColor)
			e.Size = seq(0.5, 0)
			e.Lifetime = NumberRange.new(0.08, 0.15)
			e.Rate = 10
			e.Speed = NumberRange.new(8, 14)
			e.SpreadAngle = Vector2.new(180, 180)
		elseif element == "Magic" then
			e.Texture = TEX.Sparkle
			e.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 160, 240)), ColorSequenceKeypoint.new(1, eColor) })
			e.Size = seq(0.45, 0)
			e.Lifetime = NumberRange.new(0.8, 1.2)
			e.Rate = 7
			e.Speed = NumberRange.new(0.5, 1)
			e.RotSpeed = NumberRange.new(-120, 120)
			e.Acceleration = Vector3.new(0, 2, 0)
		end
	end

	if order >= 3 then
		local l = Instance.new("PointLight")
		l.Color = rColor
		l.Range = 6 + order * 2
		l.Brightness = 1 + order * 0.25
		l.Shadows = false
		l.Parent = anchor
	end

	-- Leuchtkreis unter dem Pet
	local circle = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, 6.5, 6.5),
		CFrame = CFrame.new(padPosition + Vector3.new(0, 0.85, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = rColor,
		Transparency = 0.55,
	})
	table.insert(cleanup, circle)

	-- Ab Legendary: Lichtsaeule und Umriss
	local highlight: Highlight? = nil
	if order >= 5 then
		local pillar = fxPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(14, 3, 3),
			CFrame = CFrame.new(padPosition + Vector3.new(0, 7.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = rColor,
			Transparency = 0.85,
		})
		table.insert(cleanup, pillar)
		local h = Instance.new("Highlight")
		h.Adornee = model
		h.FillTransparency = 1
		h.OutlineColor = rColor
		h.OutlineTransparency = 0.2
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.Parent = anchor
		highlight = h
	end

	-- Mythic: Kugeln, die um das Pet kreisen
	local orbs: { BasePart } = {}
	if order >= 6 then
		for i = 1, 3 do
			local orb = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6, Position = cf.Position, Color = rColor })
			local trail0 = Instance.new("Attachment")
			trail0.Position = Vector3.new(0, 0.25, 0)
			trail0.Parent = orb
			local trail1 = Instance.new("Attachment")
			trail1.Position = Vector3.new(0, -0.25, 0)
			trail1.Parent = orb
			local trail = Instance.new("Trail")
			trail.Attachment0 = trail0
			trail.Attachment1 = trail1
			trail.Lifetime = 0.3
			trail.LightEmission = 1
			trail.FaceCamera = true
			trail.Transparency = seq(0.2, 1)
			trail.Parent = orb
			orb:SetAttribute("Index", i)
			table.insert(orbs, orb)
			table.insert(cleanup, orb)
		end
	end

	local rainbow = order >= 6
	local handle: AuraHandle = {
		Update = function(t: number)
			circle.Transparency = 0.55 + math.sin(t * 3) * 0.15
			if rainbow then
				local c = Color3.fromHSV((t * 0.25) % 1, 0.7, 1)
				main.Color = colorSeq(Color3.new(1, 1, 1), c)
				circle.Color = c
				if highlight then
					highlight.OutlineColor = c
				end
				local center = anchor.Position
				for i, orb in orbs do
					local a = t * 2.5 + i * (math.pi * 2 / #orbs)
					orb.Position = center + Vector3.new(math.cos(a) * 3, math.sin(t * 3 + i) * 0.8, math.sin(a) * 3)
					orb.Color = c
				end
			end
		end,
		Destroy = function()
			for _, inst in cleanup do
				inst:Destroy()
			end
		end,
	}
	return handle
end

function PetVFX.Spawn(model: Model, padPosition: Vector3)
	local rarity = model:GetAttribute("Rarity") or "Common"
	local order = rarityOrder(rarity)
	local color = rarityColor(rarity)
	local ground = padPosition + Vector3.new(0, 1, 0)

	-- Lichtsaeule
	local pillar = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(30, 4 + order, 4 + order),
		CFrame = CFrame.new(ground + Vector3.new(0, 15, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Transparency = 0.2,
	})
	tween(pillar, 0.6, { Size = Vector3.new(30, 0.2, 0.2), Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
	Debris:AddItem(pillar, 0.65)

	ring(ground, color, 1, 7 + order, 0.5, 18)
	if order >= 4 then
		task.delay(0.12, ring, ground, Color3.new(1, 1, 1), 1, 10 + order, 0.55, 22)
	end
	burst(ground, {
		Color = colorSeq(Color3.new(1, 1, 1), color),
		Count = 20 + order * 8,
		Size = seq(0.8, 0),
		Speed = NumberRange.new(10, 25),
		Lifetime = NumberRange.new(0.5, 1),
		Spread = Vector2.new(35, 35),
		Acceleration = Vector3.new(0, -15, 0),
	})
	flash(ground + Vector3.new(0, 3, 0), color, 1, 7 + order, 0.3)
	flashLight(ground, color, 20, 4, 0.6)
	if order >= 5 then
		speedLines(ground + Vector3.new(0, 3, 0), color, 12, 4, 0.35)
	end
end

--------------------------------------------------------------------------
-- Zombies: Laufanimation, Treffer-Aufblitzen, Status, Tod
--------------------------------------------------------------------------

export type ZombieVisual = {
	Model: Model,
	Animate: (t: number) -> (),
	Flash: () -> (),
	SetSlowed: (on: boolean) -> (),
	SetBurning: (on: boolean) -> (),
	Die: () -> (),
}

local ICE = Color3.fromRGB(140, 210, 255)

function PetVFX.Zombie(model: Model): ZombieVisual
	local torso = model:WaitForChild("Torso", 5) :: BasePart?
	local parts: { { Part: BasePart, Color: Color3 } } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" and d.Name ~= "Eye" then
			table.insert(parts, { Part = d, Color = d.Color })
		end
	end
	local function joint(name: string): Motor6D?
		return if torso then torso:FindFirstChild(name) :: Motor6D? else nil
	end
	local rootPart = model:FindFirstChild("Root")
	local rootJoint = if rootPart then rootPart:FindFirstChild("RootJoint") :: Motor6D? else nil
	local neck, lArm, rArm, lLeg, rLeg = joint("Neck"), joint("LeftShoulder"), joint("RightShoulder"), joint("LeftHip"), joint("RightHip")

	local speed = model:GetAttribute("Speed") or 5
	local seed = math.random() * 10
	local slowed, flashing, dead = false, false, false
	local frost: ParticleEmitter? = nil
	local fire: ParticleEmitter? = nil

	local function recolor()
		for _, entry in parts do
			local c = entry.Color
			if slowed then
				c = c:Lerp(ICE, 0.55)
			end
			if flashing then
				c = c:Lerp(Color3.new(1, 1, 1), 0.75)
			end
			entry.Part.Color = c
		end
	end

	local visual: ZombieVisual = {
		Model = model,
		Animate = function(t: number)
			if dead then
				return
			end
			local rate = speed * 0.9 * (if slowed then 0.5 else 1)
			local phase = t * rate + seed
			local swing = math.sin(phase) * 0.7
			if lLeg then
				lLeg.Transform = CFrame.Angles(swing, 0, 0)
			end
			if rLeg then
				rLeg.Transform = CFrame.Angles(-swing, 0, 0)
			end
			if lArm then
				lArm.Transform = CFrame.Angles(math.sin(phase + 1) * 0.15, 0, 0.05)
			end
			if rArm then
				rArm.Transform = CFrame.Angles(math.sin(phase + 2.5) * 0.15, 0, -0.05)
			end
			if neck then
				neck.Transform = CFrame.Angles(math.sin(phase * 0.5) * 0.1, 0, 0.3 + math.sin(phase * 0.7) * 0.1)
			end
			if rootJoint then
				rootJoint.Transform = CFrame.new(0, math.abs(math.sin(phase)) * 0.15, 0) * CFrame.Angles(0, 0, math.sin(phase) * 0.08)
			end
		end,
		Flash = function()
			if dead then
				return
			end
			flashing = true
			recolor()
			task.delay(0.07, function()
				flashing = false
				if not dead then
					recolor()
				end
			end)
		end,
		SetSlowed = function(on: boolean)
			slowed = on
			recolor()
			if on and not frost and torso then
				local e = Instance.new("ParticleEmitter")
				e.Texture = TEX.Sparkle
				e.Color = colorSeq(Color3.new(1, 1, 1), ICE)
				e.Size = seq(0.4, 0)
				e.Lifetime = NumberRange.new(0.5, 0.9)
				e.Rate = 12
				e.Speed = NumberRange.new(0.5, 1.5)
				e.SpreadAngle = Vector2.new(180, 180)
				e.Acceleration = Vector3.new(0, -3, 0)
				e.LightEmission = 1
				e.Shape = Enum.ParticleEmitterShape.Box
				e.Parent = torso
				frost = e
			elseif not on and frost then
				frost:Destroy()
				frost = nil
			end
		end,
		SetBurning = function(on: boolean)
			if on and not fire and torso then
				local e = Instance.new("ParticleEmitter")
				e.Texture = TEX.Fire
				e.Color = colorSeq(Color3.fromRGB(255, 210, 90), Color3.fromRGB(255, 50, 10))
				e.Size = seq(1.4, 0)
				e.Lifetime = NumberRange.new(0.3, 0.6)
				e.Rate = 25
				e.Speed = NumberRange.new(1, 3)
				e.Acceleration = Vector3.new(0, 8, 0)
				e.LightEmission = 1
				e.Shape = Enum.ParticleEmitterShape.Box
				e.Parent = torso
				fire = e
			elseif not on and fire then
				fire:Destroy()
				fire = nil
			end
		end,
		Die = function()
			if dead then
				return
			end
			dead = true
			local isBoss = model:GetAttribute("ZombieType") == "Boss"
			local _, size = model:GetBoundingBox()
			local pos = if torso then torso.Position else model:GetPivot().Position
			-- Aufloesen: gruen einfaerben, schrumpfen, durchsichtig werden
			for _, entry in parts do
				tween(entry.Part, 0.45, { Color = Color3.fromRGB(60, 255, 90), Transparency = 1 })
			end
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") and d.Name == "Eye" then
					d.Transparency = 1
				elseif d:IsA("BillboardGui") then
					d.Enabled = false
				elseif d:IsA("ParticleEmitter") then
					d.Enabled = false
				end
			end
			local s = if isBoss then 2 else 1
			flash(pos, Color3.fromRGB(90, 255, 110), 1, size.Y * 0.9, 0.3)
			burst(pos, {
				Texture = TEX.Smoke,
				Color = colorSeq(Color3.fromRGB(120, 255, 120), Color3.fromRGB(30, 70, 30)),
				Count = 10 * s,
				Size = seq(1.5 * s, 4 * s),
				Speed = NumberRange.new(3, 8),
				Lifetime = NumberRange.new(0.6, 1.1),
				Transparency = seq(0.3, 1),
				LightEmission = 0.3,
			})
			burst(pos, { Color = colorSeq(Color3.new(1, 1, 1), Color3.fromRGB(90, 255, 90)), Count = 14 * s, Size = seq(0.6, 0), Speed = NumberRange.new(10, 22) })
			-- Kleiner Geist, der nach oben schwebt
			popText(pos, "👻", Color3.new(1, 1, 1), 0.8 * s, 6, 1)
			if isBoss then
				ring(pos - Vector3.new(0, size.Y * 0.4, 0), Color3.fromRGB(190, 90, 255), 1, 18, 0.7, 28)
				speedLines(pos, Color3.fromRGB(220, 160, 255), 14, 6, 0.4)
				flashLight(pos, Color3.fromRGB(190, 90, 255), 40, 6, 0.8)
			end
		end,
	}
	return visual
end

function PetVFX.ZombieAppear(position: Vector3)
	burst(position, {
		Texture = TEX.Smoke,
		Color = colorSeq(Color3.fromRGB(110, 230, 100), Color3.fromRGB(30, 60, 30)),
		Count = 6,
		Size = seq(2, 4),
		Speed = NumberRange.new(2, 5),
		Lifetime = NumberRange.new(0.5, 0.9),
		Transparency = seq(0.4, 1),
		LightEmission = 0.4,
	})
end

--------------------------------------------------------------------------
-- Huette wird getroffen
--------------------------------------------------------------------------

function PetVFX.HutHit(position: Vector3, damage: number)
	local s = math.clamp(damage / 20, 0.6, 3)
	shards(position + Vector3.new(0, 2, 0), Color3.fromRGB(140, 95, 60), math.floor(6 * s), Enum.Material.WoodPlanks)
	burst(position + Vector3.new(0, 2, 0), {
		Texture = TEX.Smoke,
		Color = colorSeq(Color3.fromRGB(150, 130, 110)),
		Count = math.floor(6 * s),
		Size = seq(1.5, 4),
		Speed = NumberRange.new(3, 8),
		Lifetime = NumberRange.new(0.5, 1),
		Transparency = seq(0.3, 1),
		LightEmission = 0,
	})
	flash(position + Vector3.new(0, 2, 0), Color3.fromRGB(255, 60, 40), 1, 4 * s, 0.2)
	popText(position + Vector3.new(0, 4, 0), "-" .. damage, Color3.fromRGB(255, 70, 50), 1.3, 4, 0.9)
end

return PetVFX
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">2_in_ServerScriptService</string>
      </Properties>
      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">ZombieDefense</string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[-- Geld im Zombie-Modus. Am Anfang gibt es bewusst wenig, damit man nicht
-- sofort reich ist; mit jeder Welle steigt die Belohnung.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.ZombieDefense.Config)

local E = Config.Economy
local Economy = {}

-- Gesammelte Bruchteile pro Spieler (z.B. 0,2 Coins pro Kill)
local fractions: { [Player]: number } = {}

-- Findet den Coins-Wert in leaderstats (oder legt ihn an).
-- Falls dein Spiel Coins woanders speichert, hier anpassen.
local function getCoinsValue(player: Player): ValueBase?
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		if not E.CreateLeaderstatsIfMissing then
			return nil
		end
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local value = leaderstats:FindFirstChild(E.CurrencyName)
	if not value then
		if not E.CreateLeaderstatsIfMissing then
			return nil
		end
		local created = Instance.new("IntValue")
		created.Name = E.CurrencyName
		created.Value = E.StartingCoins
		created.Parent = leaderstats
		value = created
	end

	if value:IsA("IntValue") or value:IsA("NumberValue") then
		return value
	end
	return nil
end

function Economy.GetCoins(player: Player): number
	local value = getCoinsValue(player) :: any
	return if value then value.Value else 0
end

-- Fuegt Coins hinzu (auch Bruchteile); gibt die tatsaechlich gutgeschriebenen ganzen Coins zurueck
function Economy.Award(player: Player, amount: number): number
	if amount <= 0 then
		return 0
	end
	local total = (fractions[player] or 0) + amount
	local whole = math.floor(total)
	fractions[player] = total - whole
	if whole > 0 then
		local value = getCoinsValue(player) :: any
		if value then
			value.Value += whole
		end
	end
	return whole
end

function Economy.TrySpend(player: Player, amount: number): boolean
	if amount <= 0 then
		return true
	end
	local value = getCoinsValue(player) :: any
	if not value or value.Value < amount then
		return false
	end
	value.Value -= amount
	return true
end

-- Multiplikator je nach Welle: Welle 1 = EarlyGameMultiplier, ab RampWaves = 1, danach waechst er langsam
function Economy.Multiplier(wave: number): number
	local ramp = math.max(E.EarlyGameRampWaves, 2)
	if wave <= ramp then
		local t = (wave - 1) / (ramp - 1)
		return E.EarlyGameMultiplier + (1 - E.EarlyGameMultiplier) * t
	end
	return math.min(1 + (wave - ramp) * E.GrowthPerWaveAfterRamp, E.MaxMultiplier)
end

function Economy.KillReward(zombieType: string, wave: number): number
	local base = E.KillReward[zombieType] or 1
	return base * Economy.Multiplier(wave)
end

function Economy.WaveBonus(wave: number): number
	return (E.WaveBonusBase + E.WaveBonusPerWave * wave) * Economy.Multiplier(wave)
end

Players.PlayerRemoving:Connect(function(player)
	fractions[player] = nil
end)

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="Script" referent="10">
          <Properties>
            <string name="Name">Main</string>
            <token name="RunContext">0</token>
            <string name="Source"><![CDATA[-- Zombie-Modus: Hauptskript (Wellen, Huette, Belohnungen).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("ZombieDefense")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)

local Economy = require(script.Parent.Economy)
local MapBuilder = require(script.Parent.MapBuilder)
local PetService = require(script.Parent.PetService)
local ZombieService = require(script.Parent.ZombieService)

-- Remotes anlegen
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in { "Attack", "Damage", "ZombieDied", "HutHit", "Message", "OpenPicker", "PlacePet", "RemovePet", "CoinsEarned" } do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
end
remotes.Parent = Shared

local refs = MapBuilder.Build()
ZombieService.Init(refs.Zombies, remotes)
PetService.Init(refs.Slots, refs.PlacedPets, remotes)

local wave = 0
local hutHealth = Config.Hut.MaxHealth
local spawnsLeft = 0

local function setState(state: string)
	Shared:SetAttribute("State", state)
end

local function setHut(value: number)
	hutHealth = math.clamp(value, 0, Config.Hut.MaxHealth)
	Shared:SetAttribute("HutHealth", hutHealth)
	Shared:SetAttribute("HutMaxHealth", Config.Hut.MaxHealth)
	local ratio = hutHealth / Config.Hut.MaxHealth
	refs.HutFill.Size = UDim2.fromScale(ratio, 1)
	refs.HutFill.BackgroundColor3 = Color3.fromRGB(230, 60, 50):Lerp(Color3.fromRGB(90, 220, 90), ratio)
	refs.HutText.Text = ("%d / %d"):format(math.ceil(hutHealth), Config.Hut.MaxHealth)
end

local function updateZombiesLeft()
	Shared:SetAttribute("ZombiesLeft", spawnsLeft + ZombieService.AliveCount())
end

-- Spieler gelten als aktiv, wenn sie in der Zombie-Map sind oder Pets platziert haben
local function activePlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if PetService.HasPets(player) or (root and Layout.IsInside(root.Position)) then
			table.insert(list, player)
		end
	end
	return list
end

local function broadcast(text: string, kind: string)
	for _, player in activePlayers() do
		remotes.Message:FireClient(player, text, kind)
	end
end

ZombieService.OnKilled = function(zombie, killer)
	updateZombiesLeft()
	if killer and killer.Parent then
		local gained = Economy.Award(killer, Economy.KillReward(zombie.TypeName, wave))
		if gained > 0 then
			remotes.CoinsEarned:FireClient(killer, gained, zombie.Root.Position)
		end
	end
end

ZombieService.OnReachedHut = function(zombie)
	setHut(hutHealth - zombie.HutDamage)
	updateZombiesLeft()
end

local function pickZombieType(w: number): string
	local total = 0
	local pool = {}
	for name, def in Config.ZombieTypes do
		if not def.IsBoss and w >= (def.FromWave or 1) then
			total += def.Weight or 1
			table.insert(pool, { name, def.Weight or 1 })
		end
	end
	local roll = math.random() * total
	for _, entry in pool do
		roll -= entry[2]
		if roll <= 0 then
			return entry[1]
		end
	end
	return "Zombie"
end

-- Laeuft eine Welle; Ergebnis: "Cleared", "GameOver" oder "Abandoned"
local function runWave(w: number): string
	local W = Config.Waves
	local count = math.min(W.BaseCount + W.CountPerWave * (w - 1), W.MaxCount)
	local interval = math.max(W.SpawnInterval - W.SpawnIntervalDecay * (w - 1), W.MinSpawnInterval)
	local hasBoss = W.BossEvery > 0 and w % W.BossEvery == 0
	spawnsLeft = count + (if hasBoss then 1 else 0)
	updateZombiesLeft()

	local stop = false
	task.spawn(function()
		for _ = 1, count do
			if stop then
				return
			end
			ZombieService.Spawn(pickZombieType(w), w)
			spawnsLeft -= 1
			updateZombiesLeft()
			task.wait(interval)
		end
		if hasBoss and not stop then
			broadcast("👑 Ein BOSS kommt!", "Boss")
			task.wait(1.5)
			if not stop then
				ZombieService.Spawn("Boss", w)
				spawnsLeft -= 1
				updateZombiesLeft()
			end
		end
	end)

	while true do
		task.wait(0.25)
		if hutHealth <= 0 then
			stop = true
			return "GameOver"
		end
		if #activePlayers() == 0 then
			stop = true
			return "Abandoned"
		end
		if spawnsLeft <= 0 and ZombieService.AliveCount() == 0 then
			return "Cleared"
		end
	end
end

local function resetRound()
	ZombieService.ClearAll()
	spawnsLeft = 0
	wave = 0
	Shared:SetAttribute("Wave", 0)
	setHut(Config.Hut.MaxHealth)
	updateZombiesLeft()
end

resetRound()
setState("Waiting")

while true do
	if #activePlayers() == 0 then
		if wave > 0 then
			resetRound()
		end
		setState("Waiting")
		task.wait(1)
		continue
	end

	-- Pause zum Platzieren
	setState("Intermission")
	local pause = if wave == 0 then Config.Waves.FirstIntermission else Config.Waves.Intermission
	local abandoned = false
	for t = pause, 1, -1 do
		Shared:SetAttribute("Countdown", t)
		task.wait(1)
		if #activePlayers() == 0 then
			abandoned = true
			break
		end
	end
	if abandoned then
		continue
	end

	wave += 1
	Shared:SetAttribute("Wave", wave)
	setState("Wave")
	broadcast(("🧟 Welle %d"):format(wave), "Wave")

	local result = runWave(wave)
	if result == "GameOver" then
		setState("GameOver")
		broadcast(("💥 Die Hütte wurde zerstört! Du hast %d Wellen geschafft."):format(wave - 1), "Error")
		ZombieService.ClearAll()
		task.wait(Config.Waves.GameOverPause)
		resetRound()
	elseif result == "Cleared" then
		local bonus = Economy.WaveBonus(wave)
		for _, player in activePlayers() do
			local gained = Economy.Award(player, bonus)
			local text = ("✅ Welle %d geschafft!"):format(wave)
			if gained > 0 then
				text ..= ("  +%d Coins"):format(gained)
			end
			remotes.Message:FireClient(player, text, "Reward")
		end
		setHut(hutHealth + Config.Hut.RegenPerWave)
	else
		resetRound()
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Baut die Zombie-Map nach der Skizze:
--   [ Zombies ]==[ Mitte: Pets oben/unten am Rand ]==[ Huette ]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.ZombieDefense.Config)
local Layout = require(ReplicatedStorage.ZombieDefense.Layout)

local M = Config.Map
local W = Layout.World
local TEX = Config.VFX.Textures

local MapBuilder = {}

export type MapRefs = {
	Root: Folder,
	Zombies: Folder,
	PlacedPets: Folder,
	Slots: { [string]: BasePart },
	HutFill: Frame,
	HutText: TextLabel,
	HutModel: Model,
}

local function part(props: { [string]: any }): BasePart
	local p = Instance.new(props.ClassName or "Part") :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "ClassName" and key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

-- Boden mit Oberkante bei y = 0
local function floor(parent: Instance, name: string, x: number, z: number, sx: number, sz: number, color: Color3, material: Enum.Material)
	return part({
		Name = name,
		Size = Vector3.new(sx, 4, sz),
		Position = W(x, -2, z),
		Color = color,
		Material = material,
		Parent = parent,
	})
end

local function stripe(parent: Instance, x: number, z: number, sx: number, sz: number, color: Color3, material: Enum.Material, height: number?)
	local h = height or 0.2
	return part({
		Name = "Path",
		Size = Vector3.new(sx, h, sz),
		Position = W(x, h / 2, z),
		Color = color,
		Material = material,
		CanCollide = false,
		Parent = parent,
	})
end

local function billboardLabel(adornee: BasePart, text: string, color: Color3, studsWide: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(studsWide, 0, studsWide / 4, 0)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.MaxDistance = 250
	gui.LightInfluence = 0
	gui.Parent = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	return gui
end

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.LightEmission = 0.5
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

local function light(parent: Instance, color: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	return l
end

-- Portal mit Torbogen; gibt die Beruehrungsflaeche zurueck
local function portal(parent: Instance, name: string, position: Vector3, color: Color3, text: string): BasePart
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	local stone = Color3.fromRGB(70, 70, 80)
	for _, side in { -1, 1 } do
		part({ Size = Vector3.new(1.5, 10, 1.5), Position = position + Vector3.new(0, 5, side * 4), Color = stone, Material = Enum.Material.Slate, Parent = model })
	end
	part({ Size = Vector3.new(1.5, 1.5, 9.5), Position = position + Vector3.new(0, 10.5, 0), Color = stone, Material = Enum.Material.Slate, Parent = model })
	local field = part({
		Name = "Field",
		Size = Vector3.new(0.6, 9, 6.5),
		Position = position + Vector3.new(0, 5, 0),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
		Parent = model,
	})
	emitter(field, {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(color),
		Rate = 25,
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
	})
	light(field, color, 16, 2)
	billboardLabel(field, text, color, 12).StudsOffset = Vector3.new(0, 7.5, 0)
	model.PrimaryPart = field
	return field
end

local function buildLane(env: Folder)
	local laneX = (Layout.LaneMinX + Layout.CenterMinX) / 2
	local halfW = M.LaneWidth / 2
	floor(env, "ZombieLane", laneX, 0, M.LaneLength, M.LaneWidth, Color3.fromRGB(52, 58, 48), Enum.Material.Ground)
	stripe(env, laneX, 0, M.LaneLength, 16, Color3.fromRGB(88, 72, 55), Enum.Material.Ground)

	-- Gruftor, aus dem die Zombies kommen
	local gateX = Layout.LaneMinX + 1.5
	local dark = Color3.fromRGB(45, 45, 52)
	for _, side in { -1, 1 } do
		part({ Size = Vector3.new(3, 14, 3), Position = W(gateX, 7, side * 9), Color = dark, Material = Enum.Material.Slate, Parent = env })
		part({ Size = Vector3.new(1.4, 1.4, 1.4), Position = W(gateX, 14.7, side * 9), Color = Color3.fromRGB(120, 255, 90), Material = Enum.Material.Neon, Parent = env })
	end
	-- Rueckwand, damit man hinten nicht runterfaellt
	part({ Size = Vector3.new(2, 16, M.LaneWidth), Position = W(Layout.LaneMinX - 1, 8, 0), Color = dark, Material = Enum.Material.Slate, Parent = env })
	local beam = part({ Size = Vector3.new(3, 3, 21), Position = W(gateX, 15.5, 0), Color = dark, Material = Enum.Material.Slate, Parent = env })
	billboardLabel(beam, "🧟 ZOMBIES", Color3.fromRGB(140, 255, 110), 14)
	local gate = part({
		Name = "ZombieGate",
		Size = Vector3.new(0.6, 14, 15),
		Position = W(gateX, 7, 0),
		Color = Color3.fromRGB(70, 200, 60),
		Material = Enum.Material.Neon,
		Transparency = 0.45,
		CanCollide = false,
		Parent = env,
	})
	emitter(gate, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(90, 220, 80), Color3.fromRGB(30, 60, 30)),
		Rate = 12,
		Lifetime = NumberRange.new(2, 3.5),
		Speed = NumberRange.new(2, 4),
		EmissionDirection = Enum.NormalId.Right,
		SpreadAngle = Vector2.new(25, 25),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 7) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) }),
		LightEmission = 0.3,
	})
	light(gate, Color3.fromRGB(110, 255, 90), 24, 2.5)

	-- Grabsteine, Laternen und Zaun am Rand
	local rng = Random.new(7)
	local x = Layout.LaneMinX + 10
	local i = 0
	while x < Layout.CenterMinX - 4 do
		i += 1
		for _, side in { -1, 1 } do
			local z = side * (halfW - 2.5) + rng:NextNumber(-0.8, 0.8)
			local tilt = CFrame.Angles(rng:NextNumber(-0.12, 0.12), 0, rng:NextNumber(-0.12, 0.12))
			local base = CFrame.new(W(x + rng:NextNumber(-2, 2), 0, z)) * tilt
			local stoneColor = Color3.fromRGB(115, 115, 122):Lerp(Color3.fromRGB(80, 85, 80), rng:NextNumber())
			part({ Size = Vector3.new(0.8, 3, 2.6), CFrame = base * CFrame.new(0, 1.5, 0), Color = stoneColor, Material = Enum.Material.Slate, Parent = env })
			part({
				ClassName = "Part",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.8, 2.6, 2.6),
				CFrame = base * CFrame.new(0, 3, 0),
				Color = stoneColor,
				Material = Enum.Material.Slate,
				Parent = env,
			})
		end
		if i % 2 == 0 then
			for _, side in { -1, 1 } do
				local z = side * (halfW - 0.8)
				part({ Size = Vector3.new(0.5, 7, 0.5), Position = W(x, 3.5, z), Color = Color3.fromRGB(35, 35, 40), Material = Enum.Material.Metal, Parent = env })
				local head = part({ Size = Vector3.new(1.2, 1.2, 1.2), Position = W(x, 7.4, z), Color = Color3.fromRGB(170, 255, 120), Material = Enum.Material.Neon, Parent = env })
				light(head, Color3.fromRGB(150, 255, 110), 18, 1.6)
			end
		end
		x += 11
	end

	for _, side in { -1, 1 } do
		local z = side * halfW
		for px = Layout.LaneMinX, Layout.CenterMinX, 4 do
			part({ Size = Vector3.new(0.4, 3.5, 0.4), Position = W(px, 1.75, z), Color = Color3.fromRGB(30, 30, 35), Material = Enum.Material.Metal, Parent = env })
		end
		for _, y in { 1.2, 3 } do
			part({ Size = Vector3.new(M.LaneLength, 0.3, 0.3), Position = W(laneX, y, z), Color = Color3.fromRGB(30, 30, 35), Material = Enum.Material.Metal, Parent = env })
		end
	end

	-- Bodennebel
	for _, fx in { 0.2, 0.5, 0.8 } do
		local mist = part({
			Name = "Mist",
			Size = Vector3.new(20, 1, M.LaneWidth - 4),
			Position = W(Layout.LaneMinX + M.LaneLength * fx, 0.5, 0),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			Parent = env,
		})
		emitter(mist, {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(150, 190, 150)),
			Rate = 3,
			Lifetime = NumberRange.new(5, 8),
			Speed = NumberRange.new(0.3, 0.8),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 10) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 0.82), NumberSequenceKeypoint.new(1, 1) }),
			LightEmission = 0,
			Shape = Enum.ParticleEmitterShape.Box,
		})
	end
end

local function buildCenter(env: Folder, slotFolder: Folder): { [string]: BasePart }
	local halfDepth = M.CenterDepth / 2
	local hw = M.PathHalfWidth
	floor(env, "Center", 0, 0, M.CenterWidth, M.CenterDepth, Color3.fromRGB(78, 135, 62), Enum.Material.Grass)
	stripe(env, 0, 0, M.CenterWidth, hw * 2 - 4, Color3.fromRGB(88, 72, 55), Enum.Material.Ground)

	-- Die Linien = der "Rand" zwischen Weg und Pet-Flaechen
	for _, side in { -1, 1 } do
		stripe(env, 0, side * hw, M.CenterWidth, 1, Color3.fromRGB(225, 215, 190), Enum.Material.Concrete, 0.35)
		-- Hecke aussen
		part({ Size = Vector3.new(M.CenterWidth, 3, 2), Position = W(0, 1.5, side * (halfDepth - 1)), Color = Color3.fromRGB(45, 95, 45), Material = Enum.Material.Grass, Parent = env })
		-- Hecken an den Seiten der Pet-Flaechen
		local bandLen = halfDepth - hw
		for _, xSide in { Layout.CenterMinX + 1, Layout.CenterMaxX - 1 } do
			part({ Size = Vector3.new(2, 3, bandLen), Position = W(xSide, 1.5, side * (hw + bandLen / 2)), Color = Color3.fromRGB(45, 95, 45), Material = Enum.Material.Grass, Parent = env })
		end
	end

	local slots = {}
	for _, slot in Layout.Slots do
		local pos = slot.Position
		local pad = part({
			Name = "Slot_" .. slot.Id,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.8, 8, 8),
			CFrame = CFrame.new(pos + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(205, 195, 175),
			Material = Enum.Material.Slate,
			Parent = slotFolder,
		})
		pad:SetAttribute("SlotId", slot.Id)
		pad:SetAttribute("Occupied", false)
		local ring = part({
			Name = "Ring",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.7, 9, 9),
			CFrame = CFrame.new(pos + Vector3.new(0, 0.35, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(120, 220, 255),
			Material = Enum.Material.Neon,
			Transparency = 0.3,
			CanCollide = false,
			CanQuery = false,
			Parent = pad,
		})
		ring:SetAttribute("BaseColor", ring.Color)

		local click = Instance.new("ClickDetector")
		click.MaxActivationDistance = 300
		click.Parent = pad

		local plus = billboardLabel(pad, "+ Pet", Color3.fromRGB(255, 255, 255), 5)
		plus.Name = "PlusGui"
		plus.StudsOffset = Vector3.new(0, 2.5, 0)
		slots[slot.Id] = pad
	end
	return slots
end

local function buildHut(env: Folder): (Model, Frame, TextLabel)
	local hut = Instance.new("Model")
	hut.Name = "Hut"
	hut.Parent = env

	local areaX = (Layout.HutAreaMinX + Layout.HutAreaMaxX) / 2
	floor(env, "HutArea", areaX, 0, M.HutAreaLength, M.HutAreaWidth, Color3.fromRGB(95, 150, 70), Enum.Material.Grass)
	stripe(env, (Layout.HutAreaMinX + Layout.HutFrontX) / 2, 0, Layout.HutFrontX - Layout.HutAreaMinX, 10, Color3.fromRGB(88, 72, 55), Enum.Material.Ground)

	local cx = Layout.HutCenterX
	local size = Layout.HutSize
	local half = size.X / 2
	local wood = Color3.fromRGB(140, 95, 60)
	local woodMat = Enum.Material.WoodPlanks
	local h = size.Y

	part({ Name = "Floor", Size = Vector3.new(size.X, 0.4, size.Z), Position = W(cx, 0.2, 0), Color = Color3.fromRGB(110, 75, 50), Material = woodMat, Parent = hut })
	part({ Name = "BackWall", Size = Vector3.new(1, h, size.Z), Position = W(cx + half - 0.5, h / 2, 0), Color = wood, Material = woodMat, Parent = hut })
	for _, side in { -1, 1 } do
		part({ Name = "SideWall", Size = Vector3.new(size.X, h, 1), Position = W(cx, h / 2, side * (half - 0.5)), Color = wood, Material = woodMat, Parent = hut })
		-- Vorderwand mit Tueroeffnung (4 breit)
		part({ Name = "FrontWall", Size = Vector3.new(1, h, 6), Position = W(cx - half + 0.5, h / 2, side * 5), Color = wood, Material = woodMat, Parent = hut })
		-- Leuchtende Fenster
		for _, wx in { -3.5, 3.5 } do
			local win = part({ Size = Vector3.new(2.6, 2.6, 0.3), Position = W(cx + wx, 5.5, side * (half + 0.05)), Color = Color3.fromRGB(255, 210, 120), Material = Enum.Material.Neon, Parent = hut })
			win.CanCollide = false
		end
		part({ Size = Vector3.new(0.3, 2.2, 2.2), Position = W(cx - half - 0.05, 5.5, side * 5.5), Color = Color3.fromRGB(255, 210, 120), Material = Enum.Material.Neon, CanCollide = false, Parent = hut })
	end
	part({ Name = "Lintel", Size = Vector3.new(1, 3, 4), Position = W(cx - half + 0.5, h - 1.5, 0), Color = wood, Material = woodMat, Parent = hut })
	part({ Name = "Door", Size = Vector3.new(0.5, 7, 4), Position = W(cx - half + 0.6, 3.5, 0), Color = Color3.fromRGB(90, 58, 35), Material = woodMat, Parent = hut })
	part({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5), Position = W(cx - half + 0.2, 3.5, 1.3), Color = Color3.fromRGB(255, 200, 60), Material = Enum.Material.Metal, Parent = hut })

	-- Satteldach: zwei Keile, First entlang X
	local roofColor = Color3.fromRGB(160, 60, 45)
	local roofH = 5
	part({ ClassName = "WedgePart", Name = "Roof", Size = Vector3.new(size.X + 2, roofH, size.Z / 2 + 1), CFrame = CFrame.new(W(cx, h + roofH / 2, -(size.Z / 4 + 0.5))), Color = roofColor, Material = Enum.Material.Slate, Parent = hut })
	part({ ClassName = "WedgePart", Name = "Roof", Size = Vector3.new(size.X + 2, roofH, size.Z / 2 + 1), CFrame = CFrame.new(W(cx, h + roofH / 2, size.Z / 4 + 0.5)) * CFrame.Angles(0, math.pi, 0), Color = roofColor, Material = Enum.Material.Slate, Parent = hut })

	local chimney = part({ Name = "Chimney", Size = Vector3.new(2, 6, 2), Position = W(cx + 4, h + 3.5, -3), Color = Color3.fromRGB(150, 80, 65), Material = Enum.Material.Brick, Parent = hut })
	emitter(chimney, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(200, 200, 200)),
		Rate = 4,
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(2, 3),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(10, 10),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 4) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) }),
		LightEmission = 0,
	})

	-- Laterne an der Tuer
	local lantern = part({ Size = Vector3.new(0.8, 1.2, 0.8), Position = W(cx - half - 0.6, 7, -2.8), Color = Color3.fromRGB(255, 170, 70), Material = Enum.Material.Neon, Parent = hut })
	light(lantern, Color3.fromRGB(255, 170, 80), 16, 2)

	-- Zaun rund um den Huettenbereich (Eingang zum Weg bleibt offen)
	local fenceColor = Color3.fromRGB(120, 85, 55)
	local hz = M.HutAreaWidth / 2
	for _, side in { -1, 1 } do
		part({ Size = Vector3.new(M.HutAreaLength, 0.4, 0.4), Position = W(areaX, 2, side * (hz - 0.3)), Color = fenceColor, Material = Enum.Material.Wood, Parent = env })
		for fx = Layout.HutAreaMinX + 2, Layout.HutAreaMaxX, 4 do
			part({ Size = Vector3.new(0.5, 3, 0.5), Position = W(fx, 1.5, side * (hz - 0.3)), Color = fenceColor, Material = Enum.Material.Wood, Parent = env })
		end
	end
	part({ Size = Vector3.new(0.4, 0.4, M.HutAreaWidth), Position = W(Layout.HutAreaMaxX - 0.3, 2, 0), Color = fenceColor, Material = Enum.Material.Wood, Parent = env })

	-- Lebensbalken ueber der Huette
	local anchor = part({ Name = "HealthAnchor", Size = Vector3.new(1, 1, 1), Position = W(cx, h + roofH + 4, 0), Transparency = 1, CanCollide = false, CanQuery = false, Parent = hut })
	local gui = Instance.new("BillboardGui")
	gui.Name = "HutHealth"
	gui.Size = UDim2.new(14, 0, 3, 0)
	gui.MaxDistance = 300
	gui.LightInfluence = 0
	gui.Parent = anchor
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.45)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextStrokeTransparency = 0.2
	title.Text = "🏠 Hütte"
	title.Parent = gui
	local back = Instance.new("Frame")
	back.Position = UDim2.fromScale(0, 0.52)
	back.Size = UDim2.fromScale(1, 0.42)
	back.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	back.BorderSizePixel = 0
	back.Parent = gui
	Instance.new("UICorner", back).CornerRadius = UDim.new(0.5, 0)
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(90, 220, 90)
	fill.BorderSizePixel = 0
	fill.Parent = back
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0.5, 0)
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.3
	text.ZIndex = 2
	text.Parent = back

	hut.PrimaryPart = anchor
	return hut, fill, text
end

local function teleportOnTouch(touchPart: BasePart, target: Vector3)
	local cooldown: { [Player]: number } = {}
	touchPart.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and game:GetService("Players"):GetPlayerFromCharacter(character)
		if not player or (cooldown[player] and os.clock() - cooldown[player] < 2) then
			return
		end
		cooldown[player] = os.clock()
		;(character :: Model):PivotTo(CFrame.new(target))
	end)
end

function MapBuilder.Build(): MapRefs
	local old = workspace:FindFirstChild("ZombieDefenseMap")
	if old then
		old:Destroy()
	end

	local root = Instance.new("Folder")
	root.Name = "ZombieDefenseMap"
	local env = Instance.new("Folder")
	env.Name = "Environment"
	env.Parent = root
	local slotFolder = Instance.new("Folder")
	slotFolder.Name = "Slots"
	slotFolder.Parent = root
	local zombies = Instance.new("Folder")
	zombies.Name = "Zombies"
	zombies.Parent = root
	local pets = Instance.new("Folder")
	pets.Name = "PlacedPets"
	pets.Parent = root

	buildLane(env)
	local slots = buildCenter(env, slotFolder)
	local hutModel, hutFill, hutText = buildHut(env)

	if M.CreateLobbyPortal then
		local portals = Instance.new("Folder")
		portals.Name = "Portals"
		portals.Parent = root
		local toMap = portal(portals, "ZombiePortal", M.LobbyPortalPosition, Color3.fromRGB(110, 255, 90), "🧟 Zombie-Modus")
		teleportOnTouch(toMap, Layout.PlayerSpawn)
		local back = portal(portals, "ReturnPortal", Layout.ReturnPortal, Color3.fromRGB(110, 180, 255), "🏡 Zur Lobby")
		teleportOnTouch(back, M.LobbyPortalPosition + Vector3.new(8, 4, 0))
	end

	root.Parent = workspace

	return {
		Root = root,
		Zombies = zombies,
		PlacedPets = pets,
		Slots = slots,
		HutFill = hutFill,
		HutText = hutText,
		HutModel = hutModel,
	}
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">PetInventory</string>
            <string name="Source"><![CDATA[-- Verbindung zu deinem Pet-System.
-- Falls deine Pets anders gespeichert sind, nur GetPets() anpassen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.ZombieDefense.Config)

local PetInventory = {}

-- Gibt die Pet-Namen eines Spielers zurueck (doppelte Namen = mehrere Exemplare).
-- Standard: Ordner player.Pets; jedes Kind ist ein Pet. Der Name kommt aus
-- dem Attribut "PetName", einem StringValue-Wert oder dem Namen des Kindes.
function PetInventory.GetPets(player: Player): { string }
	local result = {}
	local folder = player:FindFirstChild(Config.Inventory.PlayerFolderName)
	if folder then
		for _, child in folder:GetChildren() do
			local name = child:GetAttribute("PetName")
			if typeof(name) ~= "string" then
				name = if child:IsA("StringValue") and child.Value ~= "" then child.Value else child.Name
			end
			table.insert(result, name)
		end
	end
	if #result == 0 then
		for _, name in Config.Inventory.StarterPets do
			table.insert(result, name)
		end
	end
	return result
end

-- Sucht ein Model fuer das Pet in ReplicatedStorage/ServerStorage
function PetInventory.FindTemplate(petName: string): Model?
	for _, container in { ReplicatedStorage, ServerStorage } do
		for _, folderName in Config.Inventory.ModelFolderNames do
			local folder = container:FindFirstChild(folderName)
			local model = folder and folder:FindFirstChild(petName)
			if model and model:IsA("Model") then
				return model
			end
		end
	end
	return nil
end

return PetInventory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[-- Pets auf den Rand-Plaetzen: platzieren, entfernen, angreifen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.ZombieDefense.Config)
local Layout = require(ReplicatedStorage.ZombieDefense.Layout)
local PetData = require(ReplicatedStorage.ZombieDefense.PetData)
local Economy = require(script.Parent.Economy)
local PetInventory = require(script.Parent.PetInventory)
local ZombieService = require(script.Parent.ZombieService)

type Placed = {
	SlotId: string,
	Owner: Player,
	Info: PetData.PetInfo,
	Model: Model,
	Position: Vector3,
	Cooldown: number,
}

local PetService = {}

local placed: { [string]: Placed } = {}
local slotParts: { [string]: BasePart } = {}
local petFolder: Folder
local remotes: any -- Ordner mit RemoteEvents
local lastAction: { [Player]: number } = {}

local function message(player: Player, text: string, kind: string?)
	remotes.Message:FireClient(player, text, kind or "Info")
end

local function countPlaced(player: Player, petName: string?): number
	local n = 0
	for _, p in placed do
		if p.Owner == player and (petName == nil or p.Info.Name == petName) then
			n += 1
		end
	end
	return n
end

-- Einfaches Platzhalter-Pet, falls es kein Model mit dem Namen gibt
local function buildPlaceholder(info: PetData.PetInfo): Model
	local model = Instance.new("Model")
	local color = if info.Element == "Normal" then Config.Rarities[info.Rarity].Color else Config.Elements[info.Element].Color
	local function add(shape: Enum.PartType, size: Vector3, offset: CFrame, c: Color3, material: Enum.Material?): Part
		local p = Instance.new("Part")
		p.Shape = shape
		p.Size = size
		p.CFrame = offset
		p.Color = c
		p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local body = add(Enum.PartType.Ball, Vector3.new(3, 3, 3), CFrame.new(), color)
	body.Name = "Body"
	add(Enum.PartType.Ball, Vector3.new(1.9, 1.9, 1.9), CFrame.new(0, -0.35, -0.75), color:Lerp(Color3.new(1, 1, 1), 0.5))
	for _, x in { -0.55, 0.55 } do
		add(Enum.PartType.Ball, Vector3.new(0.6, 0.7, 0.6), CFrame.new(x, 0.35, -1.25), Color3.fromRGB(25, 25, 30))
		add(Enum.PartType.Ball, Vector3.new(0.22, 0.22, 0.22), CFrame.new(x + 0.1, 0.5, -1.52), Color3.new(1, 1, 1), Enum.Material.Neon)
		add(Enum.PartType.Block, Vector3.new(0.6, 0.9, 0.35), CFrame.new(x * 1.3, 1.55, 0) * CFrame.Angles(0, 0, -x * 0.5), color)
		add(Enum.PartType.Ball, Vector3.new(0.8, 0.6, 1), CFrame.new(x * 1.2, -1.3, -0.3), color:Lerp(Color3.new(), 0.15))
	end
	add(Enum.PartType.Ball, Vector3.new(0.7, 0.7, 1.3), CFrame.new(0, -0.3, 1.5), color)
	model.PrimaryPart = body
	return model
end

local function makePetModel(info: PetData.PetInfo, template: Model?): Model
	local model = if template then template:Clone() else buildPlaceholder(info)
	for _, d in model:GetDescendants() do
		if d:IsA("BaseScript") or d:IsA("Humanoid") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false -- Klicks gehen durch auf den Platz darunter
		end
	end
	local _, size = model:GetBoundingBox()
	local maxDim = math.max(size.X, size.Y, size.Z)
	if maxDim > 0 then
		model:ScaleTo(model:GetScale() * Config.Inventory.PetSize / maxDim)
	end
	return model
end

local function setSlotState(slotId: string, p: Placed?)
	local pad = slotParts[slotId]
	pad:SetAttribute("Occupied", p ~= nil)
	pad:SetAttribute("OwnerUserId", if p then p.Owner.UserId else nil)
	local plus = pad:FindFirstChild("PlusGui") :: BillboardGui?
	if plus then
		plus.Enabled = p == nil
	end
	local ring = pad:FindFirstChild("Ring") :: BasePart?
	if ring then
		ring.Color = if p then Config.Rarities[p.Info.Rarity].Color else ring:GetAttribute("BaseColor") :: Color3
	end
end

local function place(player: Player, slotId: string, petName: string)
	local pad = slotParts[slotId]
	if not pad or placed[slotId] then
		message(player, "Dieser Platz ist schon belegt.", "Error")
		return
	end
	if countPlaced(player) >= Config.PetPlacement.MaxPetsPerPlayer then
		message(player, ("Du kannst maximal %d Pets platzieren."):format(Config.PetPlacement.MaxPetsPerPlayer), "Error")
		return
	end

	local owned = 0
	for _, name in PetInventory.GetPets(player) do
		if name == petName then
			owned += 1
		end
	end
	if owned == 0 or countPlaced(player, petName) >= owned then
		message(player, "Dieses Pet hast du nicht (mehr) frei.", "Error")
		return
	end
	if not Economy.TrySpend(player, Config.PetPlacement.PlacementCost) then
		message(player, "Nicht genug Coins.", "Error")
		return
	end

	local template = PetInventory.FindTemplate(petName)
	local info = PetData.Get(petName, template)
	local model = makePetModel(info, template)

	-- Ueber dem Platz schweben lassen, Blick zum Weg
	local slotPos = pad.Position
	local _, size = model:GetBoundingBox()
	local center = slotPos + Vector3.new(0, 0.4 + size.Y / 2 + 1.2, 0)
	local facing = Vector3.new(slotPos.X, center.Y, Layout.Origin.Z) -- Wegmitte
	local bboxCF = model:GetBoundingBox()
	local pivotToCenter = model:GetPivot():ToObjectSpace(bboxCF)
	model:PivotTo(CFrame.lookAt(center, facing) * pivotToCenter:Inverse())

	model.Name = "Pet_" .. slotId
	model:SetAttribute("SlotId", slotId)
	model:SetAttribute("PetName", petName)
	model:SetAttribute("Rarity", info.Rarity)
	model:SetAttribute("Element", info.Element)
	model:SetAttribute("Range", info.Range)
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("OwnerName", player.DisplayName)
	model.Parent = petFolder

	local p: Placed = {
		SlotId = slotId,
		Owner = player,
		Info = info,
		Model = model,
		Position = center,
		Cooldown = 0.5,
	}
	placed[slotId] = p
	setSlotState(slotId, p)
end

local function remove(slotId: string)
	local p = placed[slotId]
	if not p then
		return
	end
	placed[slotId] = nil
	p.Model:Destroy()
	setSlotState(slotId, nil)
end

local function onSlotClicked(player: Player, slotId: string)
	local p = placed[slotId]
	if p and p.Owner ~= player then
		message(player, ("Dieser Platz gehört %s."):format(p.Owner.DisplayName), "Error")
		return
	end

	-- Eigene Pets zusammenfassen (Name -> Anzahl)
	local counts: { [string]: number } = {}
	for _, name in PetInventory.GetPets(player) do
		counts[name] = (counts[name] or 0) + 1
	end
	local options = {}
	for name, count in counts do
		local info = PetData.Get(name, PetInventory.FindTemplate(name))
		table.insert(options, {
			Name = name,
			Rarity = info.Rarity,
			Element = info.Element,
			Damage = info.Damage,
			Range = info.Range,
			Available = count - countPlaced(player, name),
		})
	end
	table.sort(options, function(a, b)
		local ra, rb = PetData.RarityOrder(a.Rarity), PetData.RarityOrder(b.Rarity)
		if ra ~= rb then
			return ra > rb
		end
		return a.Name < b.Name
	end)

	remotes.OpenPicker:FireClient(player, slotId, options, {
		OwnSlot = p ~= nil,
		PlacedPet = if p then p.Info.Name else nil,
		Placed = countPlaced(player),
		Max = Config.PetPlacement.MaxPetsPerPlayer,
	})
end

local function rateLimited(player: Player): boolean
	local now = os.clock()
	if lastAction[player] and now - lastAction[player] < 0.25 then
		return true
	end
	lastAction[player] = now
	return false
end

-- Schuss abfeuern: Clients zeigen den Effekt, der Server macht den Schaden nach der Flugzeit
local function attack(p: Placed, target: ZombieService.Zombie)
	local info = p.Info
	local element = info.Element
	local el = Config.Elements[element]
	local isCrit = math.random() < Config.CritChance
	local damage = info.Damage * (if isCrit then Config.CritMultiplier else 1)

	local from = p.Position
	local to = target.Root.Position
	local travel = if element == "Lightning" then 0.06 else (to - from).Magnitude / Config.VFX.ProjectileSpeed

	-- Blitz springt auf weitere Zombies
	local chain: { ZombieService.Zombie } = {}
	local chainPositions: { Vector3 } = {}
	if element == "Lightning" then
		local near = ZombieService.InRange(to, el.ChainRange)
		table.sort(near, function(a, b)
			return (a.Root.Position - to).Magnitude < (b.Root.Position - to).Magnitude
		end)
		for _, z in near do
			if z ~= target and #chain < el.ChainCount then
				table.insert(chain, z)
				table.insert(chainPositions, z.Root.Position)
			end
		end
	end

	remotes.Attack:FireAllClients({
		SlotId = p.SlotId,
		Element = element,
		Rarity = info.Rarity,
		From = from,
		To = to,
		TargetId = target.Id,
		Travel = travel,
		Chain = chainPositions,
		Crit = isCrit,
	})

	local owner = p.Owner
	task.delay(travel, function()
		local impact = if target.Alive then target.Root.Position else to
		if target.Alive then
			local died = ZombieService.Damage(target, damage, owner, element, isCrit)
			if not died then
				if element == "Fire" then
					ZombieService.ApplyBurn(target, damage * el.BurnFraction, el.BurnDuration, owner)
				elseif element == "Ice" then
					ZombieService.ApplySlow(target, el.SlowFactor, el.SlowDuration)
				end
			end
		end
		if element == "Magic" then
			for _, z in ZombieService.InRange(impact, el.SplashRadius) do
				if z ~= target then
					ZombieService.Damage(z, damage * el.SplashFraction, owner, element, false)
				end
			end
		elseif element == "Lightning" then
			for _, z in chain do
				ZombieService.Damage(z, damage * el.ChainFraction, owner, element, false)
			end
		end
	end)
end

local function step(dt: number)
	for _, p in placed do
		p.Cooldown -= dt
		if p.Cooldown > 0 then
			continue
		end
		-- Ziel: der Zombie, der am naechsten an der Huette ist
		local best: ZombieService.Zombie? = nil
		for _, z in ZombieService.InRange(p.Position, p.Info.Range) do
			if not best or z.Progress > best.Progress then
				best = z
			end
		end
		if best then
			attack(p, best)
			p.Cooldown = p.Info.Cooldown
		else
			p.Cooldown = 0.1
		end
	end
end

function PetService.Init(slots: { [string]: BasePart }, folder: Folder, remoteFolder: any)
	slotParts = slots
	petFolder = folder
	remotes = remoteFolder

	for slotId, pad in slots do
		local click = pad:FindFirstChildOfClass("ClickDetector")
		if click then
			click.MouseClick:Connect(function(player)
				onSlotClicked(player, slotId)
			end)
		end
	end

	remotes.PlacePet.OnServerEvent:Connect(function(player, slotId, petName)
		if typeof(slotId) ~= "string" or typeof(petName) ~= "string" or rateLimited(player) then
			return
		end
		place(player, slotId, petName)
	end)

	remotes.RemovePet.OnServerEvent:Connect(function(player, slotId)
		if typeof(slotId) ~= "string" or rateLimited(player) then
			return
		end
		local p = placed[slotId]
		if p and p.Owner == player then
			remove(slotId)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
		for slotId, p in placed do
			if p.Owner == player then
				remove(slotId)
			end
		end
	end)

	RunService.Heartbeat:Connect(step)
end

function PetService.HasPets(player: Player): boolean
	return countPlaced(player) > 0
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">ZombieService</string>
            <string name="Source"><![CDATA[-- Zombies: bauen, laufen lassen, Schaden, Brennen/Verlangsamen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.ZombieDefense.Config)
local Layout = require(ReplicatedStorage.ZombieDefense.Layout)

export type Zombie = {
	Id: number,
	TypeName: string,
	Model: Model,
	Root: BasePart,
	HealthFill: Frame,
	Health: number,
	MaxHealth: number,
	Speed: number,
	HutDamage: number,
	Scale: number,
	Progress: number, -- 0 = Tor, 1 = Huette
	Offset: number, -- seitlicher Versatz
	SlowUntil: number,
	SlowFactor: number,
	BurnUntil: number,
	BurnDps: number,
	BurnOwner: Player?,
	Alive: boolean,
}

local ZombieService = {}

local folder: Folder
local remotes: any -- Ordner mit RemoteEvents
local zombies: { [number]: Zombie } = {}
local nextId = 0
local pathLength = (Layout.ZombieEnd - Layout.ZombieStart).Magnitude

-- Wird vom Hauptskript gesetzt
ZombieService.OnKilled = function(_zombie: Zombie, _killer: Player?) end
ZombieService.OnReachedHut = function(_zombie: Zombie) end

local function weld(a: BasePart, b: BasePart, name: string, c0: CFrame, c1: CFrame): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = a
	m.Part1 = b
	m.C0 = c0
	m.C1 = c1
	m.Parent = a
	return m
end

-- Feste Verbindung ueber C0 (wird von Model:ScaleTo mitskaliert)
local function attach(part0: BasePart, part1: BasePart, offset: CFrame)
	local w = Instance.new("Weld")
	w.Part0 = part0
	w.Part1 = part1
	w.C0 = offset
	w.Parent = part1
end

local function newPart(model: Model, name: string, size: Vector3, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- Blockiger Zombie mit Gelenken (die Laufanimation macht der Client)
local function buildModel(typeName: string, def: any): (Model, BasePart, Frame)
	local model = Instance.new("Model")
	model.Name = typeName

	local root = newPart(model, "Root", Vector3.new(2, 2, 1), Color3.new(), nil)
	root.Transparency = 1
	root.Anchored = true

	local torso = newPart(model, "Torso", Vector3.new(2, 2, 1), def.Shirt)
	local head = newPart(model, "Head", Vector3.new(1.25, 1.25, 1.25), def.Skin)
	local lArm = newPart(model, "LeftArm", Vector3.new(1, 2, 1), def.Skin)
	local rArm = newPart(model, "RightArm", Vector3.new(1, 2, 1), def.Skin)
	local lLeg = newPart(model, "LeftLeg", Vector3.new(1, 2, 1), def.Pants)
	local rLeg = newPart(model, "RightLeg", Vector3.new(1, 2, 1), def.Pants)

	weld(root, torso, "RootJoint", CFrame.new(), CFrame.new())
	weld(torso, head, "Neck", CFrame.new(0, 1, 0), CFrame.new(0, -0.625, 0))
	-- Arme nach vorne gestreckt (typische Zombie-Haltung)
	local armPose = CFrame.Angles(math.rad(90), 0, 0)
	weld(torso, lArm, "LeftShoulder", CFrame.new(-1.5, 0.5, 0) * armPose, CFrame.new(0, 0.5, 0))
	weld(torso, rArm, "RightShoulder", CFrame.new(1.5, 0.5, 0) * armPose, CFrame.new(0, 0.5, 0))
	weld(torso, lLeg, "LeftHip", CFrame.new(-0.5, -1, 0), CFrame.new(0, 1, 0))
	weld(torso, rLeg, "RightHip", CFrame.new(0.5, -1, 0), CFrame.new(0, 1, 0))

	-- Leuchtende Augen
	for _, x in { -0.28, 0.28 } do
		local eye = newPart(model, "Eye", Vector3.new(0.25, 0.2, 0.1), def.Eyes, Enum.Material.Neon)
		attach(head, eye, CFrame.new(x, 0.12, -0.63))
	end
	-- Zerrissenes Hemd: ein dunkler Fleck
	local rip = newPart(model, "Rip", Vector3.new(0.8, 0.6, 0.05), def.Shirt:Lerp(Color3.new(), 0.45))
	attach(torso, rip, CFrame.new(0.3, -0.4, -0.52))

	if def.IsBoss then
		-- Hoerner + Aura fuer den Boss
		for _, x in { -0.45, 0.45 } do
			local horn = newPart(model, "Horn", Vector3.new(0.3, 0.8, 0.3), Color3.fromRGB(240, 230, 200))
			attach(head, horn, CFrame.new(x, 0.9, 0) * CFrame.Angles(0, 0, if x > 0 then -0.35 else 0.35))
		end
		local aura = Instance.new("ParticleEmitter")
		aura.Texture = Config.VFX.Textures.Smoke
		aura.Color = ColorSequence.new(Color3.fromRGB(160, 60, 255), Color3.fromRGB(40, 0, 60))
		aura.Rate = 10
		aura.Lifetime = NumberRange.new(1, 1.6)
		aura.Speed = NumberRange.new(1, 2)
		aura.SpreadAngle = Vector2.new(180, 180)
		aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 3) })
		aura.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		aura.LightEmission = 0.6
		aura.Parent = torso
	end

	-- Lebensbalken
	local gui = Instance.new("BillboardGui")
	gui.Name = "HealthBar"
	gui.Size = UDim2.new(if def.IsBoss then 4 else 2.6, 0, if def.IsBoss then 0.5 else 0.32, 0)
	gui.StudsOffset = Vector3.new(0, 1.3, 0)
	gui.MaxDistance = 150
	gui.LightInfluence = 0
	gui.Parent = head
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	back.BorderSizePixel = 0
	back.Parent = gui
	Instance.new("UICorner", back).CornerRadius = UDim.new(0.5, 0)
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = if def.IsBoss then Color3.fromRGB(190, 70, 255) else Color3.fromRGB(110, 230, 90)
	fill.BorderSizePixel = 0
	fill.Parent = back
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0.5, 0)
	if def.IsBoss then
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1.2, 0)
		label.Position = UDim2.fromScale(0, -1.3)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(230, 170, 255)
		label.TextStrokeTransparency = 0
		label.Text = "👑 BOSS"
		label.Parent = gui
	end

	model.PrimaryPart = root
	return model, root, fill
end

local function positionAt(z: Zombie): CFrame
	local flat = Layout.ZombieStart:Lerp(Layout.ZombieEnd, z.Progress)
	local pos = flat + Vector3.new(0, 3 * z.Scale, z.Offset)
	-- Blick Richtung Huette (+X)
	return CFrame.lookAt(pos, pos + Vector3.xAxis)
end

local function updateHealthBar(z: Zombie)
	local ratio = math.clamp(z.Health / z.MaxHealth, 0, 1)
	z.HealthFill.Size = UDim2.fromScale(ratio, 1)
	if not Config.ZombieTypes[z.TypeName].IsBoss then
		z.HealthFill.BackgroundColor3 = Color3.fromRGB(230, 60, 50):Lerp(Color3.fromRGB(110, 230, 90), ratio)
	end
end

function ZombieService.Init(zombieFolder: Folder, remoteFolder: any)
	folder = zombieFolder
	remotes = remoteFolder
	RunService.Heartbeat:Connect(ZombieService.Step)
end

function ZombieService.Spawn(typeName: string, wave: number): Zombie
	local def = Config.ZombieTypes[typeName]
	nextId += 1
	local model, root, fill = buildModel(typeName, def)
	local healthMult = 1 + (wave - 1) * Config.Waves.HealthGrowthPerWave
	local maxHealth = math.floor(def.Health * healthMult + 0.5)

	local z: Zombie = {
		Id = nextId,
		TypeName = typeName,
		Model = model,
		Root = root,
		HealthFill = fill,
		Health = maxHealth,
		MaxHealth = maxHealth,
		Speed = def.Speed,
		HutDamage = def.HutDamage,
		Scale = def.Scale,
		Progress = 0,
		Offset = if def.IsBoss then 0 else (math.random() * 2 - 1) * Layout.ZombieSpreadZ,
		SlowUntil = 0,
		SlowFactor = 1,
		BurnUntil = 0,
		BurnDps = 0,
		BurnOwner = nil,
		Alive = true,
	}

	if def.Scale ~= 1 then
		model:ScaleTo(def.Scale)
	end
	model.Name = "Z" .. z.Id
	model:SetAttribute("ZombieId", z.Id)
	model:SetAttribute("ZombieType", typeName)
	model:SetAttribute("Speed", def.Speed)
	model:PivotTo(positionAt(z))
	model.Parent = folder
	zombies[z.Id] = z
	return z
end

local function kill(z: Zombie, killer: Player?)
	if not z.Alive then
		return
	end
	z.Alive = false
	zombies[z.Id] = nil
	z.Model:SetAttribute("Dead", true)
	remotes.ZombieDied:FireAllClients(z.Id, z.Root.Position, z.TypeName)
	ZombieService.OnKilled(z, killer)
	-- Kurz warten, damit der Client den Aufloese-Effekt zeigen kann
	task.delay(0.6, function()
		z.Model:Destroy()
	end)
end

-- Fuegt Schaden zu; gibt true zurueck, wenn der Zombie gestorben ist
function ZombieService.Damage(z: Zombie, amount: number, owner: Player?, element: string, isCrit: boolean): boolean
	if not z.Alive then
		return false
	end
	z.Health -= amount
	remotes.Damage:FireAllClients(z.Id, math.floor(amount + 0.5), element, isCrit)
	if z.Health <= 0 then
		kill(z, owner)
		return true
	end
	updateHealthBar(z)
	return false
end

function ZombieService.ApplySlow(z: Zombie, factor: number, duration: number)
	z.SlowFactor = math.min(z.SlowFactor, factor)
	z.SlowUntil = math.max(z.SlowUntil, os.clock() + duration)
	z.Model:SetAttribute("Slowed", true)
end

function ZombieService.ApplyBurn(z: Zombie, dps: number, duration: number, owner: Player?)
	z.BurnDps = math.max(z.BurnDps, dps)
	z.BurnUntil = math.max(z.BurnUntil, os.clock() + duration)
	z.BurnOwner = owner
	z.Model:SetAttribute("Burning", true)
end

local burnAccumulator = 0

function ZombieService.Step(dt: number)
	local now = os.clock()
	burnAccumulator += dt
	local burnTick = burnAccumulator >= 0.5
	if burnTick then
		burnAccumulator = 0
	end

	for _, z in zombies do
		if not z.Alive then
			continue
		end

		if z.SlowUntil > 0 and now >= z.SlowUntil then
			z.SlowUntil = 0
			z.SlowFactor = 1
			z.Model:SetAttribute("Slowed", false)
		end

		if burnTick and z.BurnUntil > 0 then
			if now >= z.BurnUntil then
				z.BurnUntil = 0
				z.BurnDps = 0
				z.Model:SetAttribute("Burning", false)
			elseif ZombieService.Damage(z, z.BurnDps * 0.5, z.BurnOwner, "Fire", false) then
				continue
			end
		end

		z.Progress += z.Speed * z.SlowFactor * dt / pathLength
		if z.Progress >= 1 then
			z.Alive = false
			zombies[z.Id] = nil
			remotes.HutHit:FireAllClients(z.Root.Position, z.HutDamage)
			ZombieService.OnReachedHut(z)
			z.Model:Destroy()
		else
			z.Model:PivotTo(positionAt(z))
		end
	end
end

-- Lebende Zombies in Reichweite (nur waagerechter Abstand)
function ZombieService.InRange(position: Vector3, range: number): { Zombie }
	local result = {}
	local flatPos = Vector3.new(position.X, 0, position.Z)
	for _, z in zombies do
		if z.Alive then
			local p = z.Root.Position
			if (Vector3.new(p.X, 0, p.Z) - flatPos).Magnitude <= range then
				table.insert(result, z)
			end
		end
	end
	return result
end

function ZombieService.AliveCount(): number
	local n = 0
	for _ in zombies do
		n += 1
	end
	return n
end

function ZombieService.ClearAll()
	for id, z in zombies do
		z.Alive = false
		z.Model:Destroy()
		zombies[id] = nil
	end
end

return ZombieService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="15">
      <Properties>
        <string name="Name">3_in_StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="16">
        <Properties>
          <string name="Name">ZombieDefenseClient</string>
          <string name="Source"><![CDATA[-- Zombie-Modus: Client (Anzeige, Pet-Auswahl, Animationen, Effekte).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("ZombieDefense")
local Config = require(Shared:WaitForChild("Config"))
local Layout = require(Shared:WaitForChild("Layout"))
local PetVFX = require(Shared:WaitForChild("PetVFX"))
local Remotes = Shared:WaitForChild("Remotes")

local map = workspace:WaitForChild("ZombieDefenseMap")
local zombieFolder = map:WaitForChild("Zombies")
local petFolder = map:WaitForChild("PlacedPets")

-- Platz-Positionen kommen aus Layout (funktioniert auch mit StreamingEnabled)
local slotPositions: { [string]: Vector3 } = {}
for _, slot in Layout.Slots do
	slotPositions[slot.Id] = slot.Position
end

local ELEMENT_ICON = { Normal = "⭐", Fire = "🔥", Ice = "❄️", Lightning = "⚡", Magic = "✨" }
local ELEMENT_NAME = { Normal = "Normal", Fire = "Feuer", Ice = "Eis", Lightning = "Blitz", Magic = "Magie" }

--------------------------------------------------------------------------
-- Zombies
--------------------------------------------------------------------------

local zombieVisuals: { [number]: PetVFX.ZombieVisual } = {}

local function zombieRoot(id: number): BasePart?
	local model = zombieFolder:FindFirstChild("Z" .. id)
	return model and model:FindFirstChild("Root") :: BasePart?
end

local function onZombieAdded(model: Instance)
	if not model:IsA("Model") then
		return
	end
	task.spawn(function()
		local id = model:GetAttribute("ZombieId")
		if typeof(id) ~= "number" then
			return
		end
		local visual = PetVFX.Zombie(model)
		if not model.Parent then
			return
		end
		zombieVisuals[id] = visual
		PetVFX.ZombieAppear(model:GetPivot().Position)
		model:GetAttributeChangedSignal("Slowed"):Connect(function()
			visual.SetSlowed(model:GetAttribute("Slowed") == true)
		end)
		model:GetAttributeChangedSignal("Burning"):Connect(function()
			visual.SetBurning(model:GetAttribute("Burning") == true)
		end)
	end)
end

zombieFolder.ChildAdded:Connect(onZombieAdded)
zombieFolder.ChildRemoved:Connect(function(model)
	local id = model:GetAttribute("ZombieId")
	if typeof(id) == "number" then
		zombieVisuals[id] = nil
	end
end)
for _, model in zombieFolder:GetChildren() do
	onZombieAdded(model)
end

--------------------------------------------------------------------------
-- Pets (Schweben, zum Ziel drehen, Rueckstoss beim Angriff)
--------------------------------------------------------------------------

type PetEntry = {
	Model: Model,
	BasePosition: Vector3,
	BaseRotation: CFrame,
	BaseYaw: number,
	Yaw: number,
	TargetYaw: number,
	Lunge: number,
	LungeDir: Vector3,
	Seed: number,
	Aura: PetVFX.AuraHandle,
}

local pets: { [string]: PetEntry } = {}

local function yawOf(direction: Vector3): number
	return math.atan2(-direction.X, -direction.Z)
end

local function addNameTag(model: Model)
	local anchor = model:FindFirstChild("AuraAnchor") :: BasePart?
	if not anchor then
		return
	end
	local rarity = model:GetAttribute("Rarity") or "Common"
	local element = model:GetAttribute("Element") or "Normal"
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(7, 0, 1.8, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, anchor.Size.Y / 2 + 1.6, 0)
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	gui.Parent = anchor
	local name = Instance.new("TextLabel")
	name.Size = UDim2.fromScale(1, 0.6)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = Config.Rarities[rarity].Color
	name.TextStrokeTransparency = 0.1
	name.Text = ("%s %s"):format(ELEMENT_ICON[element] or "", tostring(model:GetAttribute("PetName")))
	name.Parent = gui
	local owner = Instance.new("TextLabel")
	owner.Position = UDim2.fromScale(0, 0.6)
	owner.Size = UDim2.fromScale(1, 0.4)
	owner.BackgroundTransparency = 1
	owner.Font = Enum.Font.GothamBold
	owner.TextScaled = true
	owner.TextColor3 = Color3.fromRGB(230, 230, 230)
	owner.TextStrokeTransparency = 0.3
	owner.Text = ("%s · %s"):format(rarity, tostring(model:GetAttribute("OwnerName")))
	owner.Parent = gui
end

local function onPetAdded(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local slotId = model:GetAttribute("SlotId")
	local padPosition = slotId and slotPositions[slotId]
	if not padPosition then
		return
	end
	local pivot = model:GetPivot()
	-- Der Server laesst das Pet zur Wegmitte schauen
	local yaw = yawOf(Vector3.new(0, 0, Layout.Origin.Z - padPosition.Z))
	local entry: PetEntry = {
		Model = model,
		BasePosition = pivot.Position,
		BaseRotation = pivot.Rotation,
		BaseYaw = yaw,
		Yaw = yaw,
		TargetYaw = yaw,
		Lunge = 0,
		LungeDir = Vector3.zero,
		Seed = math.random() * 10,
		Aura = PetVFX.Aura(model, padPosition),
	}
	pets[slotId] = entry
	addNameTag(model)
	PetVFX.Spawn(model, padPosition)
end

petFolder.ChildAdded:Connect(onPetAdded)
petFolder.ChildRemoved:Connect(function(model)
	local slotId = model:GetAttribute("SlotId")
	local entry = slotId and pets[slotId]
	if entry and entry.Model == model then
		entry.Aura.Destroy()
		pets[slotId] = nil
	end
end)
for _, model in petFolder:GetChildren() do
	onPetAdded(model)
end

--------------------------------------------------------------------------
-- Kamera-Wackeln, wenn die Huette getroffen wird
--------------------------------------------------------------------------

local shake = 0
RunService:BindToRenderStep("ZombieDefenseShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if shake <= 0.01 then
		return
	end
	local camera = workspace.CurrentCamera
	local s = shake
	camera.CFrame *= CFrame.Angles((math.random() - 0.5) * s * 0.04, (math.random() - 0.5) * s * 0.04, 0)
	shake = math.max(shake - dt * 4, 0)
end)

--------------------------------------------------------------------------
-- Animation jedes Frame
--------------------------------------------------------------------------

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	for _, visual in zombieVisuals do
		visual.Animate(t)
	end
	for _, entry in pets do
		if not entry.Model.Parent then
			continue
		end
		-- Sanft zum Ziel drehen
		local diff = (entry.TargetYaw - entry.Yaw + math.pi) % (2 * math.pi) - math.pi
		entry.Yaw += diff * math.min(dt * 10, 1)
		entry.Lunge = math.max(entry.Lunge - dt * 6, 0)
		local bob = math.sin(t * 2.2 + entry.Seed) * 0.35
		local pos = entry.BasePosition + Vector3.new(0, bob, 0) + entry.LungeDir * (entry.Lunge * 1.2)
		entry.Model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, entry.Yaw - entry.BaseYaw, 0) * entry.BaseRotation)
		entry.Aura.Update(t)
	end
end)

--------------------------------------------------------------------------
-- Effekte vom Server
--------------------------------------------------------------------------

Remotes.Attack.OnClientEvent:Connect(function(data)
	local entry = pets[data.SlotId]
	if entry then
		local dir = Vector3.new(data.To.X - entry.BasePosition.X, 0, data.To.Z - entry.BasePosition.Z)
		if dir.Magnitude > 0.1 then
			entry.TargetYaw = yawOf(dir)
			entry.LungeDir = dir.Unit
			entry.Lunge = 1
		end
	end
	local targetId = data.TargetId
	PetVFX.Attack(data, function()
		local root = zombieRoot(targetId)
		return if root then root.Position else nil
	end)
end)

Remotes.Damage.OnClientEvent:Connect(function(id, amount, element, isCrit)
	local visual = zombieVisuals[id]
	if visual then
		visual.Flash()
	end
	local root = zombieRoot(id)
	if root then
		PetVFX.DamageNumber(root.Position + Vector3.new(0, 2, 0), amount, element, isCrit)
	end
end)

Remotes.ZombieDied.OnClientEvent:Connect(function(id)
	local visual = zombieVisuals[id]
	if visual then
		visual.Die()
	end
end)

Remotes.CoinsEarned.OnClientEvent:Connect(function(amount, position)
	PetVFX.CoinPop(position, amount)
end)

Remotes.HutHit.OnClientEvent:Connect(function(position, damage)
	PetVFX.HutHit(position, damage)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and (root.Position - position).Magnitude < 120 then
		shake = math.min(shake + damage / 15, 3)
	end
end)

--------------------------------------------------------------------------
-- Anzeige (HUD)
--------------------------------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "ZombieDefenseHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function stroke(parent: Instance, color: Color3, thickness: number)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.4
	for key, value in props do
		(l :: any)[key] = value
	end
	l.Parent = parent
	return l
end

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 8)
panel.Size = UDim2.fromOffset(320, 86)
panel.BackgroundColor3 = Color3.fromRGB(25, 30, 25)
panel.BackgroundTransparency = 0.15
panel.Visible = false
panel.Parent = gui
corner(panel, 14)
stroke(panel, Color3.fromRGB(110, 230, 90), 2)

local waveLabel = label(panel, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 30), Text = "🧟 Welle 0" })
local statusLabel = label(panel, { Position = UDim2.fromOffset(12, 36), Size = UDim2.new(1, -24, 0, 20), Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(210, 230, 210), Text = "" })

local hutBack = Instance.new("Frame")
hutBack.Position = UDim2.fromOffset(12, 62)
hutBack.Size = UDim2.new(1, -24, 0, 16)
hutBack.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
hutBack.Parent = panel
corner(hutBack, 8)
local hutFill = Instance.new("Frame")
hutFill.Size = UDim2.fromScale(1, 1)
hutFill.BackgroundColor3 = Color3.fromRGB(90, 220, 90)
hutFill.Parent = hutBack
corner(hutFill, 8)
local hutText = label(hutBack, { Size = UDim2.fromScale(1, 1), ZIndex = 2, Font = Enum.Font.GothamBold, Text = "🏠" })

local function refreshHud()
	local state = Shared:GetAttribute("State")
	local wave = Shared:GetAttribute("Wave") or 0
	waveLabel.Text = if wave > 0 then ("🧟 Welle %d"):format(wave) else "🧟 Zombie-Modus"
	if state == "Intermission" then
		statusLabel.Text = ("Nächste Welle in %ds – klicke auf einen Platz am Rand!"):format(Shared:GetAttribute("Countdown") or 0)
	elseif state == "Wave" then
		statusLabel.Text = ("Zombies übrig: %d"):format(Shared:GetAttribute("ZombiesLeft") or 0)
	elseif state == "GameOver" then
		statusLabel.Text = "Die Hütte ist zerstört …"
	else
		statusLabel.Text = "Warte auf Spieler …"
	end
	local hp = Shared:GetAttribute("HutHealth") or 0
	local max = Shared:GetAttribute("HutMaxHealth") or 1
	local ratio = math.clamp(hp / max, 0, 1)
	TweenService:Create(hutFill, TweenInfo.new(0.25), {
		Size = UDim2.fromScale(ratio, 1),
		BackgroundColor3 = Color3.fromRGB(230, 60, 50):Lerp(Color3.fromRGB(90, 220, 90), ratio),
	}):Play()
	hutText.Text = ("🏠 Hütte %d / %d"):format(math.ceil(hp), max)
end

for _, attr in { "State", "Wave", "Countdown", "ZombiesLeft", "HutHealth", "HutMaxHealth" } do
	Shared:GetAttributeChangedSignal(attr):Connect(refreshHud)
end
refreshHud()

-- HUD nur in der Zombie-Map zeigen
task.spawn(function()
	while true do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		panel.Visible = root ~= nil and Layout.IsInside(root.Position)
		task.wait(0.5)
	end
end)

-- Banner fuer Meldungen
local BANNER_COLORS = {
	Info = Color3.fromRGB(255, 255, 255),
	Wave = Color3.fromRGB(140, 255, 110),
	Boss = Color3.fromRGB(210, 120, 255),
	Reward = Color3.fromRGB(255, 215, 60),
	Error = Color3.fromRGB(255, 100, 80),
}
local bannerToken = 0
local banner = label(gui, {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.28),
	Size = UDim2.fromScale(0.6, 0.08),
	TextStrokeTransparency = 0,
	TextTransparency = 1,
	Text = "",
})
local bannerScale = Instance.new("UIScale")
bannerScale.Parent = banner

Remotes.Message.OnClientEvent:Connect(function(text: string, kind: string)
	bannerToken += 1
	local token = bannerToken
	banner.Text = text
	banner.TextColor3 = BANNER_COLORS[kind] or BANNER_COLORS.Info
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0
	bannerScale.Scale = 0.4
	TweenService:Create(bannerScale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(if kind == "Error" then 2 else 2.5, function()
		if token == bannerToken then
			TweenService:Create(banner, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end)

--------------------------------------------------------------------------
-- Pet-Auswahl beim Klick auf einen Platz
--------------------------------------------------------------------------

local picker = Instance.new("Frame")
picker.AnchorPoint = Vector2.new(0.5, 0.5)
picker.Position = UDim2.fromScale(0.5, 0.55)
picker.Size = UDim2.fromScale(0.9, 0.7)
picker.BackgroundColor3 = Color3.fromRGB(28, 32, 40)
picker.Visible = false
picker.Parent = gui
corner(picker, 16)
stroke(picker, Color3.fromRGB(120, 220, 255), 2)
local pickerSizeLimit = Instance.new("UISizeConstraint")
pickerSizeLimit.MaxSize = Vector2.new(380, 420)
pickerSizeLimit.Parent = picker

local pickerTitle = label(picker, { Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -70, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, Text = "Pet wählen" })
local pickerSub = label(picker, { Position = UDim2.fromOffset(16, 40), Size = UDim2.new(1, -32, 0, 18), Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(190, 200, 210), TextXAlignment = Enum.TextXAlignment.Left, Text = "" })

local closeButton = Instance.new("TextButton")
closeButton.AnchorPoint = Vector2.new(1, 0)
closeButton.Position = UDim2.new(1, -10, 0, 10)
closeButton.Size = UDim2.fromOffset(36, 36)
closeButton.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
closeButton.Font = Enum.Font.FredokaOne
closeButton.TextScaled = true
closeButton.TextColor3 = Color3.new(1, 1, 1)
closeButton.Text = "X"
closeButton.Parent = picker
corner(closeButton, 10)

local list = Instance.new("ScrollingFrame")
list.Position = UDim2.fromOffset(12, 66)
list.Size = UDim2.new(1, -24, 1, -78)
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.ScrollBarThickness = 6
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.CanvasSize = UDim2.new()
list.Parent = picker
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = list

closeButton.Activated:Connect(function()
	picker.Visible = false
end)

local function clearList()
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function makeButton(text: string, color: Color3, order: number): TextButton
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -8, 0, 46)
	b.BackgroundColor3 = color
	b.Font = Enum.Font.FredokaOne
	b.TextScaled = true
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.LayoutOrder = order
	b.AutoButtonColor = true
	b.Parent = list
	corner(b, 10)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = b
	return b
end

Remotes.OpenPicker.OnClientEvent:Connect(function(slotId: string, options, meta)
	clearList()
	picker.Visible = true
	pickerSub.Text = ("Platziert: %d / %d  ·  Nur am Rand erlaubt"):format(meta.Placed, meta.Max)

	if meta.OwnSlot then
		pickerTitle.Text = ("Dein Pet: %s"):format(tostring(meta.PlacedPet))
		local remove = makeButton("🗑️ Pet entfernen", Color3.fromRGB(190, 60, 60), 0)
		remove.Activated:Connect(function()
			Remotes.RemovePet:FireServer(slotId)
			picker.Visible = false
		end)
		return
	end

	pickerTitle.Text = "Pet wählen"
	if #options == 0 then
		makeButton("Du hast noch keine Pets", Color3.fromRGB(70, 70, 80), 1)
		return
	end
	for i, opt in options do
		local rarityColor = Config.Rarities[opt.Rarity] and Config.Rarities[opt.Rarity].Color or Color3.new(1, 1, 1)
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, -8, 0, 64)
		row.BackgroundColor3 = Color3.fromRGB(45, 50, 62)
		row.AutoButtonColor = opt.Available > 0
		row.Text = ""
		row.LayoutOrder = i
		row.Parent = list
		corner(row, 12)
		stroke(row, rarityColor, 2)
		local stripe = Instance.new("Frame")
		stripe.Size = UDim2.new(0, 8, 1, 0)
		stripe.BackgroundColor3 = rarityColor
		stripe.Parent = row
		corner(stripe, 4)
		label(row, {
			Position = UDim2.fromOffset(18, 6),
			Size = UDim2.new(1, -110, 0, 28),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = rarityColor,
			Text = ("%s %s"):format(ELEMENT_ICON[opt.Element] or "", opt.Name),
		})
		label(row, {
			Position = UDim2.fromOffset(18, 36),
			Size = UDim2.new(1, -110, 0, 20),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.GothamBold,
			TextColor3 = Color3.fromRGB(200, 205, 215),
			Text = ("%s · %s · ⚔️ %d · 🎯 %d"):format(opt.Rarity, ELEMENT_NAME[opt.Element] or opt.Element, opt.Damage, opt.Range),
		})
		label(row, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(80, 30),
			TextColor3 = if opt.Available > 0 then Color3.fromRGB(140, 255, 120) else Color3.fromRGB(150, 150, 150),
			Text = if opt.Available > 0 then ("x%d frei"):format(opt.Available) else "benutzt",
		})
		if opt.Available <= 0 then
			row.BackgroundColor3 = Color3.fromRGB(35, 37, 45)
		else
			row.Activated:Connect(function()
				Remotes.PlacePet:FireServer(slotId, opt.Name)
				picker.Visible = false
			end)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>